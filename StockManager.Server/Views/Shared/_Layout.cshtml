<!DOCTYPE html>
<html lang="tr" data-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StockManager PRO</title>
    <!-- Google Fonts: Outfit & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%236366f1'><path d='M8.235 1.559a.5.5 0 0 0-.47 0l-7.5 4a.5.5 0 0 0 0 .882L3.188 8 .264 9.559a.5.5 0 0 0 0 .882l7.5 4a.5.5 0 0 0 .47 0l7.5-4a.5.5 0 0 0 0-.882L12.813 8l2.922-1.559a.5.5 0 0 0 0-.882l-7.5-4z'/></svg>" />
    <!-- Tema Seçimi Betiği (Sayfa titreşimini önler) -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('sm_theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
</head>

<body>
    <!-- Aurora Atmosphere Arka Plan Katmanı -->
    <div class="aurora-bg">
        <div class="aurora-blob-1"></div>
        <div class="aurora-blob-2"></div>
        <div class="aurora-blob-3"></div>
    </div>

    <div class="app-content-wrapper">
        <header>
            <nav class="navbar navbar-expand-lg navbar-floating-island sticky-top">
                <div class="container-fluid px-2">
                    <!-- Marka Logosu -->
                    <a class="navbar-brand d-flex align-items-center text-decoration-none me-4" asp-area="" asp-controller="Home" asp-action="Index">
                        <div class="navbar-brand-badge me-2.5">
                            <i class="bi bi-layers-fill"></i>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="fw-bold tracking-tight fs-5" style="letter-spacing: -0.5px;">Stock<span style="color: #6366f1;">Manager</span></span>
                            <span class="badge bg-primary bg-opacity-25 text-primary ms-2 border border-primary border-opacity-25 rounded-pill" style="font-size:0.62rem; padding: 0.35em 0.6em;">AURORA PRO</span>
                        </div>
                    </a>

                    <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <i class="bi bi-list fs-2"></i>
                    </button>

                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1 gap-2 my-2 my-lg-0 align-items-lg-center">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <li class="nav-item">
                                    <a class="nav-link-custom" asp-controller="Home" asp-action="Index">
                                        <i class="bi bi-house-door-fill me-1.5 text-primary"></i>Ana Sayfa
                                    </a>
                                </li>

                                @if (User.IsInRole("Admin") || User.IsInRole("Personel"))
                                {
                                    <li class="nav-item dropdown">
                                        <a class="nav-link-custom dropdown-toggle" href="#" id="tanimlarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-box-seam-fill me-1.5 opacity-75"></i>Tanımlar
                                        </a>
                                        <ul class="dropdown-menu shadow border-0 rounded-4 py-2 mt-2 glass-card" aria-labelledby="tanimlarDropdown">
                                            <li>
                                                <a class="dropdown-item py-2 d-flex align-items-center" asp-controller="Products" asp-action="Index">
                                                    <i class="bi bi-box me-2.5 text-primary"></i> Ürünler
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item py-2 d-flex align-items-center" asp-controller="Categories" asp-action="Index">
                                                    <i class="bi bi-tags me-2.5 text-info"></i> Kategoriler
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item py-2 d-flex align-items-center" asp-controller="Customers" asp-action="Index">
                                                    <i class="bi bi-people me-2.5 text-success"></i> Müşteriler
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item py-2 d-flex align-items-center" asp-controller="Suppliers" asp-action="Index">
                                                    <i class="bi bi-truck me-2.5 text-warning"></i> Tedarikçiler
                                                </a>
                                            </li>
                                        </ul>
                                    </li>

                                    <li class="nav-item dropdown">
                                        <a class="nav-link-custom dropdown-toggle" href="#" id="stokDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-inboxes-fill me-1.5 opacity-75"></i>Stok
                                        </a>
                                        <ul class="dropdown-menu shadow border-0 rounded-4 py-2 mt-2 glass-card" aria-labelledby="stokDropdown">
                                            <li>
                                                <a class="dropdown-item py-2 d-flex align-items-center" asp-controller="StockMovements" asp-action="Index">
                                                    <i class="bi bi-arrow-left-right me-2.5 text-primary"></i> Stok Hareketleri
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item py-2 d-flex align-items-center" asp-controller="Sales" asp-action="History">
                                                    <i class="bi bi-receipt me-2.5 text-success"></i> Satış Geçmişi
                                                </a>
                                            </li>
                                        </ul>
                                    </li>
                                }

                                @if (User.IsInRole("Admin") || User.IsInRole("Muhasebeci"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link-custom" asp-controller="Reports" asp-action="Index">
                                            <i class="bi bi-bar-chart-line-fill me-1.5" style="color: #06b6d4;"></i>Raporlar
                                        </a>
                                    </li>
                                }

                                @if (User.IsInRole("Admin"))
                                {
                                    <li class="nav-item dropdown">
                                        <a class="nav-link-custom dropdown-toggle" href="#" id="ayarlarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-gear-fill me-1.5" style="color: #f59e0b;"></i>Ayarlar
                                        </a>
                                        <ul class="dropdown-menu shadow border-0 rounded-4 py-2 mt-2 glass-card" aria-labelledby="ayarlarDropdown">
                                            <li>
                                                <a class="dropdown-item py-2 d-flex align-items-center" asp-controller="Account" asp-action="Users">
                                                    <i class="bi bi-person-badge-fill me-2.5" style="color: #f59e0b;"></i> Personel
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item py-2 d-flex align-items-center" asp-controller="AuditLogs" asp-action="Index">
                                                    <i class="bi bi-shield-lock-fill me-2.5" style="color: #10b981;"></i> Denetim Logları
                                                </a>
                                            </li>
                                        </ul>
                                    </li>
                                }
                            }
                        </ul>

                        <div class="d-flex align-items-center gap-2 mt-2 mt-lg-0">
                            <!-- Tema Değiştirme Butonu (Koyu / Aydınlık) -->
                            <button class="btn-theme-toggle border-0" type="button" id="themeToggleBtn" title="Tema Değiştir">
                                <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
                            </button>

                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                @if (User.IsInRole("Admin") || User.IsInRole("Personel"))
                                {
                                    <!-- Hızlı Satış (POS) Butonu -->
                                    <a asp-controller="Sales" asp-action="POS" class="btn-cyber-pos">
                                        <i class="bi bi-lightning-charge-fill me-1.5"></i> Hızlı Satış <span class="shortcut-kbd">F2</span>
                                    </a>

                                    <!-- Bildirim Zili -->
                                    <div class="dropdown" id="notification-area">
                                        <button class="btn-theme-toggle position-relative border-0" type="button"
                                                id="notificationMenuButton" data-bs-toggle="dropdown" aria-expanded="false"
                                                onclick="loadNotifications()">
                                            <i class="bi bi-bell fs-5"></i>
                                            <span id="notification-badge"
                                                  class="position-absolute badge rounded-pill bg-danger d-flex align-items-center justify-content-center"
                                                  style="display:none; top: 2px; right: 2px; font-size: 0.62rem; padding: 0.22em 0.4em; min-width: 16px; min-height: 16px;">
                                                0
                                            </span>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 py-2 mt-2 glass-card" aria-labelledby="notificationMenuButton"
                                            id="notification-list" style="width: 340px; max-height: 450px; overflow-y: auto; z-index: 1050;">
                                            <li class="px-3 py-2 d-flex justify-content-between align-items-center">
                                                <h6 class="mb-0 fw-bold" style="font-size: 0.92rem;">Bildirimler</h6>
                                                <button class="btn btn-xs btn-link text-info text-decoration-none p-0 fw-semibold" style="font-size: 0.76rem;" onclick="markAllAsRead(event)">
                                                    Tümünü Oku
                                                </button>
                                            </li>
                                            <li>
                                                <hr class="dropdown-divider my-1 opacity-10">
                                            </li>
                                            <div id="notification-items">
                                                <li><span class="dropdown-item text-muted text-center py-3">Yeni bildirim bulunmuyor.</span></li>
                                            </div>
                                        </ul>
                                    </div>
                                }

                                <!-- Kullanıcı Profil Menüsü -->
                                <div class="dropdown">
                                    <button class="user-avatar-pill dropdown-toggle border-0" type="button"
                                            id="userMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                        <div class="d-flex align-items-center justify-content-center rounded-circle" style="width: 28px; height: 28px; background: linear-gradient(135deg, #6366f1, #06b6d4); color: #fff;">
                                            <i class="bi bi-person-fill small"></i>
                                        </div>
                                        <span class="small">@User.Identity.Name</span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-2 py-2 glass-card" aria-labelledby="userMenuButton" style="right: 0; left: auto; min-width: 210px;">
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center text-decoration-none" asp-controller="Account" asp-action="Profile">
                                                <i class="bi bi-gear me-2 text-info"></i> Profil Ayarlarım
                                            </a>
                                        </li>
                                        <li>
                                            <hr class="dropdown-divider opacity-10">
                                        </li>
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item py-2 text-danger d-flex align-items-center">
                                                    <i class="bi bi-box-arrow-right me-2"></i> Güvenli Çıkış
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" class="btn-cyber-pos px-4">Giriş Yap</a>
                            }
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <div class="container-fluid px-3 px-lg-4 mt-3">
            <main role="main" class="pb-5">
                <!-- Uyarı ve Başarı Mesajları -->
                @if (TempData["success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm d-flex align-items-center border-0 mb-4" role="alert" style="background: rgba(16, 185, 129, 0.15); color: #10b981; backdrop-filter: blur(10px);">
                        <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                        <div>@TempData["success"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm d-flex align-items-center border-0 mb-4" role="alert" style="background: rgba(244, 63, 94, 0.15); color: #f43f5e; backdrop-filter: blur(10px);">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                        <div>@TempData["error"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Bootstrap JS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Tema Değiştirici ve Bildirim Yönetimi -->
    <script>
        // Tema Değiştirme Butonu Fonksiyonelliği
        const themeToggleBtn = document.getElementById('themeToggleBtn');
        const themeIcon = document.getElementById('themeIcon');

        function updateThemeIcon() {
            const current = document.documentElement.getAttribute('data-theme') || 'dark';
            if (current === 'light') {
                themeIcon.className = 'bi bi-sun-fill text-warning';
            } else {
                themeIcon.className = 'bi bi-moon-stars-fill text-info';
            }
        }
        updateThemeIcon();

        if (themeToggleBtn) {
            themeToggleBtn.addEventListener('click', function() {
                const current = document.documentElement.getAttribute('data-theme') || 'dark';
                const target = current === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', target);
                localStorage.setItem('sm_theme', target);
                updateThemeIcon();
            });
        }

        async function checkUnreadNotifications() {
            try {
                const response = await fetch('/Notifications/GetUnread');
                const data = await response.json();
                const badge = document.getElementById('notification-badge');

                if (data && data.count > 0) {
                    badge.textContent = data.count;
                    badge.style.display = 'flex';
                } else {
                    badge.style.display = 'none';
                }
            } catch (error) {
                console.error("Bildirimler kontrol edilemedi.", error);
            }
        }

        async function loadNotifications() {
            try {
                const response = await fetch('/Notifications/GetUnread');
                const data = await response.json();
                const container = document.getElementById('notification-items');
                container.innerHTML = '';

                if (!data || !data.items || data.items.length === 0) {
                    container.innerHTML = '<li><span class="dropdown-item text-muted text-center py-4 fs-7"><i class="bi bi-bell-slash d-block fs-3 mb-2 opacity-50"></i>Yeni bildirim bulunmuyor.</span></li>';
                    return;
                }

                data.items.forEach(item => {
                    const li = document.createElement('li');
                    li.className = 'px-3 py-2 border-bottom d-flex align-items-start gap-2';
                    li.style.borderColor = 'rgba(255,255,255,0.06)';

                    let iconClass = 'bi-info-circle-fill text-info';
                    if (item.message.includes('yetersiz') || item.message.includes('bulunmamaktadır')) {
                        iconClass = 'bi-x-circle-fill text-danger';
                    } else if (item.message.includes('kritik') || item.message.includes('limit')) {
                        iconClass = 'bi-exclamation-triangle-fill text-warning';
                    }

                    li.innerHTML = `
                        <div class="d-flex align-items-center justify-content-center rounded-circle" style="width: 32px; height: 32px; background: rgba(255,255,255,0.08); flex-shrink: 0; margin-top: 2px;">
                            <i class="bi ${iconClass}" style="font-size: 1rem;"></i>
                        </div>
                        <div class="flex-grow-1" style="min-width: 0;">
                            <div style="font-size: 0.82rem; line-height: 1.35;">
                                ${item.message}
                            </div>
                            <div class="text-muted mt-1 d-flex align-items-center gap-1" style="font-size: 0.72rem;">
                                <i class="bi bi-clock"></i> ${new Date(item.createdAt).toLocaleString('tr-TR')}
                            </div>
                        </div>
                        <button class="btn btn-sm btn-link text-muted p-1 align-self-center border-0 bg-transparent" onclick="markAsRead('${item.id}', this)" title="Okundu işaretle">
                            <i class="bi bi-check2-circle fs-5"></i>
                        </button>
                    `;
                    container.appendChild(li);
                });
            } catch (error) {
                console.error("Bildirim listesi yüklenemedi.", error);
            }
        }

        async function markAsRead(id, buttonEl) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const formData = new FormData();
            formData.append('id', id);
            if (token) formData.append('__RequestVerificationToken', token);

            try {
                const response = await fetch('/Notifications/MarkAsRead', {
                    method: 'POST',
                    body: formData
                });
                const data = await response.json();
                if (data.success) {
                    const li = buttonEl.closest('li');
                    li.style.opacity = '0';
                    setTimeout(() => {
                        li.remove();
                        checkUnreadNotifications();
                    }, 250);
                }
            } catch (error) {
                console.error("Bildirim okundu olarak işaretlenemedi.", error);
            }
        }

        async function markAllAsRead(event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const formData = new FormData();
            if (token) formData.append('__RequestVerificationToken', token);

            try {
                const response = await fetch('/Notifications/MarkAllAsRead', {
                    method: 'POST',
                    body: formData
                });
                const data = await response.json();
                if (data.success) {
                    const container = document.getElementById('notification-items');
                    container.innerHTML = '<li><span class="dropdown-item text-muted text-center py-4 fs-7"><i class="bi bi-bell-slash d-block fs-3 mb-2 opacity-50"></i>Yeni bildirim bulunmuyor.</span></li>';
                    checkUnreadNotifications();
                }
            } catch (error) {
                console.error("Bildirimler okundu olarak işaretlenemedi.", error);
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            if (document.getElementById('notification-area')) {
                checkUnreadNotifications();
                setInterval(checkUnreadNotifications, 60000);
            }

            document.addEventListener('keydown', function(e) {
                if (e.key === 'F2') {
                    e.preventDefault();
                    window.location.href = '/Sales/POS';
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>