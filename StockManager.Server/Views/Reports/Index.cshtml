@{
    ViewData["Title"] = "Raporlar";
}

<div class="mb-3">
    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Geri
    </a>
</div>

<h2>Raporlar</h2>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-primary">
            <div class="card-body">
                <h5 class="card-title">Toplam Ürün</h5>
                <p class="card-text fs-4">@ViewBag.TotalProducts</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-warning">
            <div class="card-body">
                <h5 class="card-title">Düşük Stok</h5>
                <p class="card-text fs-4">@ViewBag.LowStockCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-success">
            <div class="card-body">
                <h5 class="card-title">Toplam Satış</h5>
                <p class="card-text fs-4">@ViewBag.TotalSales.ToString("0.00")</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-info">
            <div class="card-body">
                <h5 class="card-title">Stok Değeri</h5>
                <p class="card-text fs-4">@ViewBag.TotalStockValue.ToString("0.00")</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Günlük Ciro</h5>
                <div class="mb-2">
                    <label for="turnoverDate" class="form-label">Tarih</label>
                    <input type="date" id="turnoverDate" class="form-control" />
                </div>
                <button id="btnTurnover" class="btn btn-outline-primary w-100" onclick="loadDailyTurnover()">Göster</button>
                <div id="turnoverResult" class="mt-3 d-none">
                    <hr />
                    <p>Tarih: <strong id="turnoverDateResult"></strong></p>
                    <p>Toplam Ciro: <strong id="turnoverAmount"></strong></p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">En Çok Satanlar</h5>
                <p class="text-muted">İlk 10 ürün</p>
                <button id="btnBestSellers" class="btn btn-outline-primary w-100" onclick="loadBestSellers()">Göster</button>
                <div id="bestSellersResult" class="mt-3 d-none">
                    <hr />
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Ürün</th>
                                <th>Adet</th>
                                <th>Gelir</th>
                            </tr>
                        </thead>
                        <tbody id="bestSellersBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Kar / Zarar</h5>
                <div class="mb-2">
                    <label for="plStartDate" class="form-label">Başlangıç</label>
                    <input type="date" id="plStartDate" class="form-control" />
                </div>
                <div class="mb-2">
                    <label for="plEndDate" class="form-label">Bitiş</label>
                    <input type="date" id="plEndDate" class="form-control" />
                </div>
                <button id="btnProfitLoss" class="btn btn-outline-primary w-100" onclick="loadProfitLoss()">Göster</button>
                <div id="profitLossResult" class="mt-3 d-none">
                    <hr />
                    <p>Dönem: <strong id="plPeriod"></strong></p>
                    <p>Gelir: <strong id="plRevenue"></strong></p>
                    <p>Maliyet: <strong id="plCost"></strong></p>
                    <p>Kar/Zarar: <strong id="plProfit"></strong></p>
