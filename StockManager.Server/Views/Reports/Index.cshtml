@{
    ViewData["Title"] = "Raporlar";
}

<div class="mb-3">
    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Geri
    </a>
</div>

<h2>Raporlar</h2>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-primary">
            <div class="card-body">
                <h5 class="card-title">Toplam Ürün</h5>
                <p class="card-text fs-4">@ViewBag.TotalProducts</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-warning">
            <div class="card-body">
                <h5 class="card-title">Düşük Stok</h5>
                <p class="card-text fs-4">@ViewBag.LowStockCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-success">
            <div class="card-body">
                <h5 class="card-title">Toplam Satış</h5>
                <p class="card-text fs-4">@ViewBag.TotalSales.ToString("0.00")</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-info">
            <div class="card-body">
                <h5 class="card-title">Stok Değeri</h5>
                <p class="card-text fs-4">@ViewBag.TotalStockValue.ToString("0.00")</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Günlük Ciro</h5>
                <div class="mb-2">
                    <label for="turnoverDate" class="form-label">Tarih</label>
                    <input type="date" id="turnoverDate" class="form-control" />
                </div>
                <button id="btnTurnover" class="btn btn-outline-primary w-100" onclick="loadDailyTurnover()">Göster</button>
                <div id="turnoverResult" class="mt-3" style="display:none;">
                    <hr />
                    <p>Tarih: <strong id="turnoverDateResult"></strong></p>
                    <p>Toplam Ciro: <strong id="turnoverAmount"></strong></p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">En Çok Satanlar</h5>
                <p class="text-muted">İlk 10 ürün</p>
                <button id="btnBestSellers" class="btn btn-outline-primary w-100" onclick="loadBestSellers()">Göster</button>
                <div id="bestSellersResult" class="mt-3" style="display:none;">
                    <hr />
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Ürün</th>
                                <th>Adet</th>
                                <th>Gelir</th>
                            </tr>
                        </thead>
                        <tbody id="bestSellersBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Kar / Zarar</h5>
                <div class="mb-2">
                    <label for="plStartDate" class="form-label">Başlangıç</label>
                    <input type="date" id="plStartDate" class="form-control" />
                </div>
                <div class="mb-2">
                    <label for="plEndDate" class="form-label">Bitiş</label>
                    <input type="date" id="plEndDate" class="form-control" />
                </div>
                <button id="btnProfitLoss" class="btn btn-outline-primary w-100" onclick="loadProfitLoss()">Göster</button>
                <div id="profitLossResult" class="mt-3" style="display:none;">
                    <hr />
                    <p>Dönem: <strong id="plPeriod"></strong></p>
                    <p>Gelir: <strong id="plRevenue"></strong></p>
                    <p>Maliyet: <strong id="plCost"></strong></p>
                    <p>Kar/Zarar: <strong id="plProfit"></strong></p>
                </div>
            </div>
        </div>
    </div>
</div>

<a asp-action="RemainingStock" class="btn btn-outline-primary">Kalan Stok</a>

@section Scripts {
    <script>
        async function loadDailyTurnover() {
            const resultDiv = document.getElementById('turnoverResult');
            const btn = document.getElementById('btnTurnover');

            // Toggle: açıksa kapat
            if (resultDiv.style.display === 'block') {
                resultDiv.style.display = 'none';
                btn.textContent = 'Göster';
                return;
            }

            const date = document.getElementById('turnoverDate').value;
            const url = date
                ? `/Reports/DailyTurnover?date=${date}`
                : '/Reports/DailyTurnover';

            try {
                const response = await fetch(url);
                const data = await response.json();

                document.getElementById('turnoverDateResult').textContent = data.date;
                document.getElementById('turnoverAmount').textContent = parseFloat(data.totalTurnover).toFixed(2);
                resultDiv.style.display = 'block';
                btn.textContent = 'Gizle';
            } catch (error) {
                alert('Ciro verileri yüklenirken hata oluştu.');
            }
        }

        async function loadBestSellers() {
            const resultDiv = document.getElementById('bestSellersResult');
            const btn = document.getElementById('btnBestSellers');

            // Toggle: açıksa kapat
            if (resultDiv.style.display === 'block') {
                resultDiv.style.display = 'none';
                btn.textContent = 'Göster';
                return;
            }

            try {
                const response = await fetch('/Reports/BestSellers');
                const data = await response.json();

                const tbody = document.getElementById('bestSellersBody');
                tbody.innerHTML = '';

                if (data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="3" class="text-muted">Henüz satış verisi yok.</td></tr>';
                } else {
                    data.forEach(item => {
                        const row = document.createElement('tr');
                        row.innerHTML = `
                            <td>${item.productName}</td>
                            <td>${item.unitsSold}</td>
                            <td>${parseFloat(item.revenue).toFixed(2)}</td>
                        `;
                        tbody.appendChild(row);
                    });
                }

                resultDiv.style.display = 'block';
                btn.textContent = 'Gizle';
            } catch (error) {
                alert('En çok satanlar yüklenirken hata oluştu.');
            }
        }

        async function loadProfitLoss() {
            const resultDiv = document.getElementById('profitLossResult');
            const btn = document.getElementById('btnProfitLoss');

            // Toggle: açıksa kapat
            if (resultDiv.style.display === 'block') {
                resultDiv.style.display = 'none';
                btn.textContent = 'Göster';
                return;
            }

            const startDate = document.getElementById('plStartDate').value;
            const endDate = document.getElementById('plEndDate').value;

            let url = '/Reports/ProfitLoss';
            const params = [];
            if (startDate) params.push(`startDate=${startDate}`);
            if (endDate) params.push(`endDate=${endDate}`);
            if (params.length > 0) url += '?' + params.join('&');

            try {
                const response = await fetch(url);
                const data = await response.json();

                document.getElementById('plPeriod').textContent = `${data.startDate} — ${data.endDate}`;
                document.getElementById('plRevenue').textContent = parseFloat(data.revenue).toFixed(2);
                document.getElementById('plCost').textContent = parseFloat(data.cost).toFixed(2);

                const profitEl = document.getElementById('plProfit');
                const profit = parseFloat(data.profitLoss);
                profitEl.textContent = profit.toFixed(2);
                profitEl.className = profit >= 0 ? 'text-success' : 'text-danger';
                resultDiv.style.display = 'block';
                btn.textContent = 'Gizle';
            } catch (error) {
                alert('Kar/Zarar verileri yüklenirken hata oluştu.');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('turnoverDate').value = today;

            const thirtyDaysAgo = new Date();
            thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
            document.getElementById('plStartDate').value = thirtyDaysAgo.toISOString().split('T')[0];
            document.getElementById('plEndDate').value = today;
        });
    </script>
}
