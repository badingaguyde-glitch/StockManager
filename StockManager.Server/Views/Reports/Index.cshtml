<a asp-action="RemainingStock" class="btn btn-outline-primary">Kalan Stok</a>

@section Scripts {
    <script>
        // ---------- TOGGLE YARDIMCISI ----------
        function togglePanel(panelId, btnId) {
            var panel = document.getElementById(panelId);
            var btn   = document.getElementById(btnId);
            var isHidden = panel.classList.contains('d-none');
            panel.classList.toggle('d-none');
            btn.innerHTML = isHidden
                ? '<i class="bi bi-eye-slash"></i> Gizle'
                : '<i class="bi bi-eye"></i> Göster';
        }

        // ---------- GÜNLÜK CİRO ----------
        var turnoverLoaded = false;
        async function loadDailyTurnover() {
            // Zaten yüklendi ve panel açıksa → gizle
            var panel = document.getElementById('turnoverResult');
            if (turnoverLoaded && !panel.classList.contains('d-none')) {
                togglePanel('turnoverResult', 'btnTurnover');
                return;
            }
            var date = document.getElementById('turnoverDate').value;
            var url  = date ? `/Reports/DailyTurnover?date=${date}` : '/Reports/DailyTurnover';
            try {
                var res  = await fetch(url);
                var data = await res.json();
                document.getElementById('turnoverDateResult').textContent = data.date;
                document.getElementById('turnoverAmount').textContent = parseFloat(data.totalTurnover).toFixed(2);
                turnoverLoaded = true;
                panel.classList.remove('d-none');
                document.getElementById('btnTurnover').innerHTML = '<i class="bi bi-eye-slash"></i> Gizle';
            } catch (e) {
                alert('Ciro verileri yüklenirken hata oluştu.');
            }
        }

        // ---------- EN ÇOK SATANLAR ----------
        var bestSellersLoaded = false;
        async function loadBestSellers() {
            var panel = document.getElementById('bestSellersResult');
            if (bestSellersLoaded) {
                togglePanel('bestSellersResult', 'btnBestSellers');
                return;
            }
            try {
                var res  = await fetch('/Reports/BestSellers');
                var data = await res.json();
                var tbody = document.getElementById('bestSellersBody');
                tbody.innerHTML = '';
                if (data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="3" class="text-muted">Henüz satış verisi yok.</td></tr>';
                } else {
                    data.forEach(function(item) {
                        var row = document.createElement('tr');
                        row.innerHTML = '<td>' + item.productName + '</td><td>' + item.unitsSold + '</td><td>' + parseFloat(item.revenue).toFixed(2) + '</td>';
                        tbody.appendChild(row);
                    });
                }
                bestSellersLoaded = true;
                panel.classList.remove('d-none');
                document.getElementById('btnBestSellers').innerHTML = '<i class="bi bi-eye-slash"></i> Gizle';
            } catch (e) {
                alert('En çok satanlar yüklenirken hata oluştu.');
            }
        }

        // ---------- KAR / ZARAR ----------
        var profitLossLoaded = false;
        async function loadProfitLoss() {
            var panel = document.getElementById('profitLossResult');
            if (profitLossLoaded && !panel.classList.contains('d-none')) {
                togglePanel('profitLossResult', 'btnProfitLoss');
                return;
            }
            var startDate = document.getElementById('plStartDate').value;
            var endDate   = document.getElementById('plEndDate').value;
            var url = '/Reports/ProfitLoss';
            var params = [];
            if (startDate) params.push('startDate=' + startDate);
            if (endDate)   params.push('endDate='   + endDate);
            if (params.length > 0) url += '?' + params.join('&');
            try {
                var res  = await fetch(url);
                var data = await res.json();
                document.getElementById('plPeriod').textContent  = data.startDate + ' — ' + data.endDate;
                document.getElementById('plRevenue').textContent = parseFloat(data.revenue).toFixed(2);
                document.getElementById('plCost').textContent    = parseFloat(data.cost).toFixed(2);
                var profitEl = document.getElementById('plProfit');
                var profit   = parseFloat(data.profitLoss);
                profitEl.textContent = profit.toFixed(2);
                profitEl.className   = profit >= 0 ? 'text-success fw-bold' : 'text-danger fw-bold';
                profitLossLoaded = true;
                panel.classList.remove('d-none');
                document.getElementById('btnProfitLoss').innerHTML = '<i class="bi bi-eye-slash"></i> Gizle';
            } catch (e) {
                alert('Kar/Zarar verileri yüklenirken hata oluştu.');
            }
        }

        // ---------- SAYFA YÜKLENME ----------
        document.addEventListener('DOMContentLoaded', function () {
            var today = new Date().toISOString().split('T')[0];
            document.getElementById('turnoverDate').value = today;
            var ago30 = new Date();
            ago30.setDate(ago30.getDate() - 30);
            document.getElementById('plStartDate').value = ago30.toISOString().split('T')[0];
            document.getElementById('plEndDate').value   = today;

            // Ön yükleme: "En Çok Satanlar" parametresizdir, hemen çek
            fetch('/Reports/BestSellers').then(function(r){ return r.json(); }).then(function(data){
                var tbody = document.getElementById('bestSellersBody');
                tbody.innerHTML = '';
                if (data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="3" class="text-muted">Henüz satış verisi yok.</td></tr>';
                } else {
                    data.forEach(function(item){
                        var row = document.createElement('tr');
                        row.innerHTML = '<td>' + item.productName + '</td><td>' + item.unitsSold + '</td><td>' + parseFloat(item.revenue).toFixed(2) + '</td>';
                        tbody.appendChild(row);
                    });
                }
                bestSellersLoaded = true;
            }).catch(function(){});
        });
    </script>
}
