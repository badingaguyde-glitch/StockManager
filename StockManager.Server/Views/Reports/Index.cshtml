@{
    ViewData["Title"] = "Raporlar";
}

<h2>Raporlar</h2>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-primary">
            <div class="card-body">
                <h5 class="card-title">Toplam Ürün</h5>
                <p class="card-text fs-4">@ViewBag.TotalProducts</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-warning">
            <div class="card-body">
                <h5 class="card-title">Düşük Stok</h5>
                <p class="card-text fs-4">@ViewBag.LowStockCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-success">
            <div class="card-body">
                <h5 class="card-title">Toplam Satış</h5>
                <p class="card-text fs-4">@ViewBag.TotalSales.ToString("0.00")</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-info">
            <div class="card-body">
                <h5 class="card-title">Stok Değeri</h5>
                <p class="card-text fs-4">@ViewBag.TotalStockValue.ToString("0.00")</p>
            </div>
        </div>
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="DailyTurnover" class="btn btn-outline-primary">Günlük Ciro</a>
    <a asp-action="BestSellers" class="btn btn-outline-primary">En Çok Satanlar</a>
    <a asp-action="ProfitLoss" class="btn btn-outline-primary">Kar/Zarar</a>
    <a asp-action="RemainingStock" class="btn btn-outline-primary">Kalan Stok</a>
</div>
