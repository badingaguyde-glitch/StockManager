@model IEnumerable<StockManager.Server.Models.ProductBatch>

@{
    ViewData["Title"] = "Yaklaşan Son Kullanma Tarihi (SKT) Uyarı Merkezi";
    var expiredList = ViewBag.ExpiredList as List<StockManager.Server.Models.ProductBatch> ?? new List<StockManager.Server.Models.ProductBatch>();
    var expiringSoonList = ViewBag.ExpiringSoonList as List<StockManager.Server.Models.ProductBatch> ?? new List<StockManager.Server.Models.ProductBatch>();
    var expiringLaterList = ViewBag.ExpiringLaterList as List<StockManager.Server.Models.ProductBatch> ?? new List<StockManager.Server.Models.ProductBatch>();
}

<style>
    .alert-card {
        border: none;
        border-radius: 16px;
        background: var(--bs-card-bg, #ffffff);
        box-shadow: 0 4px 15px rgba(0,0,0,.05);
    }
    .stat-card {
        border-radius: 16px;
        padding: 24px;
        color: white;
        box-shadow: 0 8px 20px rgba(0,0,0,.1);
        transition: transform .2s;
    }
    .stat-card:hover {
        transform: translateY(-4px);
    }
    .stat-expired { background: linear-gradient(135deg, #ef4444, #dc2626); }
    .stat-soon { background: linear-gradient(135deg, #f59e0b, #d97706); }
    .stat-later { background: linear-gradient(135deg, #3b82f6, #2563eb); }
</style>

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Parti & IMEI Listesine Dön
    </a>
</div>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-alarm-fill text-warning me-2"></i>Yaklaşan SKT Uyarı Merkezi</h2>
        <p class="text-muted mb-0">Gıda, eczane ve süreli ürünlerin son kullanma tarihlerini izleyin, dolmak üzere olan veya süresi dolan stokları anında yönetin.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm">
            <i class="bi bi-plus-lg me-2"></i> Yeni SKT Kaydı Ekle
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="stat-card stat-expired">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="fs-6 fw-semibold text-uppercase opacity-75">Süresi Dolmuş (Kritik)</div>
                <i class="bi bi-exclamation-triangle-fill fs-2 opacity-50"></i>
            </div>
            <div class="fs-1 fw-bold">@ViewBag.ExpiredCount <span class="fs-5 fw-normal">Parti</span></div>
            <div class="small mt-2 opacity-75">Hemen raflardan toplanmalı veya imha edilmeli</div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card stat-soon">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="fs-6 fw-semibold text-uppercase opacity-75">30 Gün Kalanlar (Çok Yakın)</div>
                <i class="bi bi-clock-history fs-2 opacity-50"></i>
            </div>
            <div class="fs-1 fw-bold">@ViewBag.ExpiringSoonCount <span class="fs-5 fw-normal">Parti</span></div>
            <div class="small mt-2 opacity-75">İndirim / promosyon ile hızlı tüketime alınmalı</div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card stat-later">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="fs-6 fw-semibold text-uppercase opacity-75">30 - 90 Gün Arası Kalanlar</div>
                <i class="bi bi-calendar-check fs-2 opacity-50"></i>
            </div>
            <div class="fs-1 fw-bold">@ViewBag.ExpiringLaterCount <span class="fs-5 fw-normal">Parti</span></div>
            <div class="small mt-2 opacity-75">Düzenli sevk ve stok kontrolü yapılmalı</div>
        </div>
    </div>
</div>

<div class="alert-card p-4 mb-4">
    <ul class="nav nav-tabs nav-fill mb-4 border-bottom" id="expiryTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold text-danger py-3" id="expired-tab" data-bs-toggle="tab" data-bs-target="#expired" type="button" role="tab">
                <i class="bi bi-x-circle-fill me-2"></i> Süresi Dolmuş Ürünler (@expiredList.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold text-warning py-3" id="soon-tab" data-bs-toggle="tab" data-bs-target="#soon" type="button" role="tab">
                <i class="bi bi-exclamation-circle-fill me-2"></i> 30 Gün İçinde Dolacaklar (@expiringSoonList.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold text-primary py-3" id="later-tab" data-bs-toggle="tab" data-bs-target="#later" type="button" role="tab">
                <i class="bi bi-info-circle-fill me-2"></i> 30-90 Gün Arasında Dolacaklar (@expiringLaterList.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="expiryTabsContent">
        <!-- 🔴 Süresi Dolmuşlar Tab -->
        <div class="tab-pane fade show active" id="expired" role="tabpanel">
            @if (!expiredList.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 fw-bold">Harika! Süresi Dolmuş Parti Yok</h5>
                    <p>Raflarınızda veya depolarınızda son kullanma tarihi geçmiş aktif ürün partisi bulunmamaktadır.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="bg-light">
                            <tr>
                                <th>Ürün Adı & Barkod</th>
                                <th>Parti / Lot</th>
                                <th>Depo</th>
                                <th>Miktar</th>
                                <th>Son Kullanma Tarihi</th>
                                <th class="text-end pe-4">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in expiredList)
                            {
                                var daysPassed = (int)(DateTime.UtcNow - b.ExpiryDate!.Value).TotalDays;
                                <tr>
                                    <td class="fw-bold text-dark">
                                        @b.ProductName
                                        <div class="small text-muted font-monospace">@b.Barcode</div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@(b.BatchNumber ?? b.SerialNumber ?? "-")</span></td>
                                    <td>@b.WarehouseName</td>
                                    <td class="fw-bold text-danger">@b.Quantity Adet</td>
                                    <td>
                                        <div class="text-danger fw-bold"><i class="bi bi-calendar-x me-1"></i>@b.ExpiryDate.Value.ToLocalTime().ToString("dd.MM.yyyy")</div>
                                        <small class="text-muted">@daysPassed gün önce doldu</small>
                                    </td>
                                    <td class="text-end pe-4">
                                        <form asp-action="UpdateStatus" asp-route-id="@b.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="status" value="Expired" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-3"
                                                    onclick="return confirm('Bu partiyi SKT Dolmuş olarak işaretleyip aktif listeden çıkarmak istiyor musunuz?')">
                                                <i class="bi bi-trash-fill me-1"></i> SKT Doldu İşaretle
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- 🟡 30 Gün Kalanlar Tab -->
        <div class="tab-pane fade" id="soon" role="tabpanel">
            @if (!expiringSoonList.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 fw-bold">Yakın Zamanda Dolacak Parti Yok</h5>
                    <p>Önümüzdeki 30 gün içinde son kullanma tarihi dolacak herhangi bir ürün bulunmuyor.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="bg-light">
                            <tr>
                                <th>Ürün Adı & Barkod</th>
                                <th>Parti / Lot</th>
                                <th>Depo</th>
                                <th>Miktar</th>
                                <th>Son Kullanma Tarihi</th>
                                <th class="text-end pe-4">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in expiringSoonList)
                            {
                                var daysLeft = (int)(b.ExpiryDate!.Value - DateTime.UtcNow).TotalDays;
                                <tr>
                                    <td class="fw-bold text-dark">
                                        @b.ProductName
                                        <div class="small text-muted font-monospace">@b.Barcode</div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@(b.BatchNumber ?? b.SerialNumber ?? "-")</span></td>
                                    <td>@b.WarehouseName</td>
                                    <td class="fw-bold text-warning text-dark">@b.Quantity Adet</td>
                                    <td>
                                        <div class="text-warning text-dark fw-bold"><i class="bi bi-clock-history me-1"></i>@b.ExpiryDate.Value.ToLocalTime().ToString("dd.MM.yyyy")</div>
                                        <small class="text-muted">@daysLeft gün kaldı</small>
                                    </td>
                                    <td class="text-end pe-4">
                                        <form asp-action="UpdateStatus" asp-route-id="@b.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="status" value="Sold" />
                                            <button type="submit" class="btn btn-outline-success btn-sm rounded-3"
                                                    onclick="return confirm('Bu partinin tamamı tüketildi/satıldı olarak işaretlensin mi?')">
                                                <i class="bi bi-check-lg me-1"></i> Tükendi İşaretle
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- 🔵 30-90 Gün Arası Tab -->
        <div class="tab-pane fade" id="later" role="tabpanel">
            @if (!expiringLaterList.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 fw-bold">30 - 90 Gün Arasında Dolacak Parti Yok</h5>
                    <p>Orta vadede son kullanma tarihi yaklaşan herhangi bir aktif stok kaydı bulunmuyor.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="bg-light">
                            <tr>
                                <th>Ürün Adı & Barkod</th>
                                <th>Parti / Lot</th>
                                <th>Depo</th>
                                <th>Miktar</th>
                                <th>Son Kullanma Tarihi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in expiringLaterList)
                            {
                                var daysLeft = (int)(b.ExpiryDate!.Value - DateTime.UtcNow).TotalDays;
                                <tr>
                                    <td class="fw-bold text-dark">
                                        @b.ProductName
                                        <div class="small text-muted font-monospace">@b.Barcode</div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@(b.BatchNumber ?? b.SerialNumber ?? "-")</span></td>
                                    <td>@b.WarehouseName</td>
                                    <td class="fw-bold text-primary">@b.Quantity Adet</td>
                                    <td>
                                        <div class="text-primary fw-bold"><i class="bi bi-calendar-check me-1"></i>@b.ExpiryDate.Value.ToLocalTime().ToString("dd.MM.yyyy")</div>
                                        <small class="text-muted">@daysLeft gün kaldı</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
