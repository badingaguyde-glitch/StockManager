@model IEnumerable<StockManager.Server.Models.ProductBatch>

@{
    ViewData["Title"] = "Parti/Lot, IMEI ve Seri No Takibi";
    var products = ViewBag.Products as List<StockManager.Server.Models.Product> ?? new List<StockManager.Server.Models.Product>();
    var searchTerm = ViewBag.SearchTerm as string;
    var currentProductId = ViewBag.CurrentProductId as string;
    var currentStatus = ViewBag.CurrentStatus as string;
}

<style>
    .batch-card {
        border: none;
        border-radius: 16px;
        background: var(--bs-card-bg, #ffffff);
        box-shadow: 0 4px 15px rgba(0,0,0,.05);
    }
    .badge-lot {
        background: rgba(99, 102, 241, 0.1);
        color: #4f46e5;
        border: 1px solid rgba(99, 102, 241, 0.2);
        font-family: monospace;
        font-size: 0.85rem;
    }
    .badge-imei {
        background: rgba(16, 185, 129, 0.1);
        color: #059669;
        border: 1px solid rgba(16, 185, 129, 0.2);
        font-family: monospace;
        font-size: 0.85rem;
    }
</style>

<div class="mb-3">
    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Geri Dön
    </a>
</div>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-upc-scan text-primary me-2"></i>Parti / Lot, Seri No & IMEI Takibi</h2>
        <p class="text-muted mb-0">Ürünlerin parti numaraları, elektronik cihazların benzersiz IMEI/seri numaraları ve son kullanma tarihleri (SKT).</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Expiring" class="btn btn-warning text-dark px-4 py-2 rounded-3 shadow-sm fw-bold d-flex align-items-center">
            <i class="bi bi-alarm-fill me-2"></i> Yaklaşan SKT Uyarı Merkezi
        </a>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm d-flex align-items-center">
            <i class="bi bi-plus-lg me-2"></i> Yeni Parti / Seri No Kaydet
        </a>
    </div>
</div>

<div class="batch-card p-4 mb-4">
    <form asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label text-muted fw-semibold">IMEI / Seri No / Parti Arama</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="searchTerm" class="form-control border-0 bg-light" placeholder="IMEI, Seri veya Parti No..." value="@searchTerm" />
            </div>
        </div>
        <div class="col-md-3">
            <label class="form-label text-muted fw-semibold">Ürün Seçimi</label>
            <select name="productId" class="form-select border-0 bg-light rounded-3" onchange="this.form.submit()">
                <option value="">Tüm Ürünler</option>
                @foreach (var p in products)
                {
                    <option value="@p.Id" selected="@(currentProductId == p.Id ? "selected" : null)">@p.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label text-muted fw-semibold">Durum Filtresi</label>
            <select name="statusFilter" class="form-select border-0 bg-light rounded-3" onchange="this.form.submit()">
                <option value="">Tüm Durumlar</option>
                <option value="Active" selected="@(currentStatus == "Active" ? "selected" : null)">Aktif Stok (Active)</option>
                <option value="Sold" selected="@(currentStatus == "Sold" ? "selected" : null)">Tükendi / Satıldı (Sold)</option>
                <option value="Expired" selected="@(currentStatus == "Expired" ? "selected" : null)">Süresi Dolmuş / SKT (Expired)</option>
                <option value="Damaged" selected="@(currentStatus == "Damaged" ? "selected" : null)">Hasarlı / İptal (Damaged)</option>
                <option value="Returned" selected="@(currentStatus == "Returned" ? "selected" : null)">Tedarikçiye İade (Returned)</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100 rounded-3">Filtrele</button>
            <a asp-action="Index" class="btn btn-light rounded-3 px-3"><i class="bi bi-x-circle"></i></a>
        </div>
    </form>
</div>

@if (!Model.Any())
{
    <div class="batch-card p-5 text-center my-4">
        <div class="py-4">
            <i class="bi bi-qr-code text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 fw-bold text-dark">Parti, Seri veya IMEI Kaydı Bulunamadı</h4>
            <p class="text-muted mx-auto" style="max-width: 450px;">Arama kriterlerinize uygun kayıt bulunamadı. Yeni bir ürün partisi ya da elektronik cihaz seri numarası ekleyebilirsiniz.</p>
            <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-3 mt-2">
                <i class="bi bi-plus-circle me-2"></i> Yeni Parti / Seri No Kaydet
            </a>
        </div>
    </div>
}
else
{
    <div class="batch-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted">
                    <tr>
                        <th class="ps-4 py-3">Ürün Adı & Barkod</th>
                        <th>Parti / Lot No</th>
                        <th>Seri No / IMEI</th>
                        <th>Depo</th>
                        <th class="text-end">Miktar</th>
                        <th>İmalat / SKT Tarihi</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isExpired = item.ExpiryDate.HasValue && item.ExpiryDate.Value < DateTime.UtcNow;
                        var isNearExpiry = item.ExpiryDate.HasValue && !isExpired && item.ExpiryDate.Value <= DateTime.UtcNow.AddDays(30);

                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@item.ProductName</div>
                                <small class="text-muted"><i class="bi bi-upc me-1"></i>@(item.Barcode ?? "-")</small>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.BatchNumber))
                                {
                                    <span class="badge badge-lot px-2 py-1">@item.BatchNumber</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.SerialNumber))
                                {
                                    <span class="badge badge-imei px-2 py-1"><i class="bi bi-phone me-1"></i>@item.SerialNumber</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border"><i class="bi bi-building me-1"></i>@item.WarehouseName</span>
                            </td>
                            <td class="text-end fw-bold text-dark">@item.Quantity Adet</td>
                            <td>
                                <div class="small">Üretim: @(item.ManufactureDate?.ToLocalTime().ToString("dd.MM.yyyy") ?? "-")</div>
                                @if (item.ExpiryDate.HasValue)
                                {
                                    <div class="small fw-semibold @(isExpired ? "text-danger" : (isNearExpiry ? "text-warning" : "text-dark"))">
                                        <i class="bi bi-calendar-x me-1"></i>SKT: @item.ExpiryDate.Value.ToLocalTime().ToString("dd.MM.yyyy")
                                        @if (isExpired) { <span class="badge bg-danger ms-1">Doldu!</span> }
                                        else if (isNearExpiry) { <span class="badge bg-warning text-dark ms-1">Yaklaşıyor</span> }
                                    </div>
                                }
                                else
                                {
                                    <small class="text-muted">SKT Belirtilmedi</small>
                                }
                            </td>
                            <td>
                                @switch (item.Status)
                                {
                                    case StockManager.Server.Models.ProductBatchStatus.Active:
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Aktif</span>
                                        break;
                                    case StockManager.Server.Models.ProductBatchStatus.Sold:
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1">Tükendi/Satıldı</span>
                                        break;
                                    case StockManager.Server.Models.ProductBatchStatus.Expired:
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">SKT Dolmuş</span>
                                        break;
                                    case StockManager.Server.Models.ProductBatchStatus.Damaged:
                                        <span class="badge bg-dark bg-opacity-10 text-dark border px-2 py-1">Hasarlı/İptal</span>
                                        break;
                                    case StockManager.Server.Models.ProductBatchStatus.Returned:
                                        <span class="badge bg-info bg-opacity-10 text-info border px-2 py-1">İade</span>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
