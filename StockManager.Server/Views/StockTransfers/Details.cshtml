@model StockManager.Server.Models.StockTransfer

@{
    ViewData["Title"] = $"Stok Transfer Detayı - {Model.TransferNumber}";
    var totalQty = Model.Items.Sum(i => i.Quantity);
}

<div class="mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Transfer Listesine Dön
    </a>
    <div class="d-flex gap-2">
        <a asp-action="DownloadPdf" asp-route-id="@Model.Id" class="btn btn-danger rounded-pill px-4 shadow-sm d-flex align-items-center gap-2">
            <i class="bi bi-file-earmark-pdf-fill fs-5"></i>
            <span>Sevk İrsaliyesi PDF İndir</span>
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Üst Bilgi Kartı -->
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-body p-4 p-lg-5">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 border-bottom pb-4 mb-4">
                    <div>
                        <span class="badge bg-primary rounded-pill px-3 py-1 mb-2">SEVK İRSALİYESİ / TRANSFER BELGESİ</span>
                        <h2 class="fw-bold mb-1 font-monospace">@Model.TransferNumber</h2>
                        <p class="text-muted small mb-0"><i class="bi bi-calendar-check me-1"></i> İşlem Tarihi: @Model.TransferDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-success rounded-pill px-4 py-2 fs-6 mb-2 d-inline-block"><i class="bi bi-check-circle-fill me-1"></i> @Model.Status</span>
                        <div class="small text-muted"><strong>İşlemi Yapan:</strong> @(string.IsNullOrWhiteSpace(Model.CreatedBy) ? "Sistem Yetkilisi" : Model.CreatedBy)</div>
                    </div>
                </div>

                <!-- Çıkış ve Giriş Depoları Görsel Kutuları -->
                <div class="row g-3 align-items-center mb-4">
                    <div class="col-12 col-md-5">
                        <div class="p-4 rounded-4 border bg-light position-relative">
                            <span class="badge bg-danger position-absolute top-0 start-0 m-3">ÇIKIŞ (GÖNDEREN) DEPO</span>
                            <div class="pt-3">
                                <h4 class="fw-bold text-dark mb-1">@Model.SourceWarehouseName</h4>
                                <div class="text-muted small"><i class="bi bi-box-arrow-right text-danger me-1"></i> Bu depodan stok düşüldü.</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-2 text-center py-2">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary" style="width: 56px; height: 56px;">
                            <i class="bi bi-arrow-right fs-3"></i>
                        </div>
                    </div>

                    <div class="col-12 col-md-5">
                        <div class="p-4 rounded-4 border bg-light position-relative">
                            <span class="badge bg-success position-absolute top-0 start-0 m-3">GİRİŞ (ALICI) DEPO</span>
                            <div class="pt-3">
                                <h4 class="fw-bold text-dark mb-1">@Model.TargetWarehouseName</h4>
                                <div class="text-muted small"><i class="bi bi-box-arrow-in-right text-success me-1"></i> Bu depoya stok eklendi.</div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="alert alert-light border rounded-3 p-3 mb-4">
                        <strong><i class="bi bi-info-circle me-1"></i> Transfer Notu / Açıklama:</strong> @Model.Notes
                    </div>
                }

                <!-- Transfer Edilen Ürün Tablosu -->
                <h5 class="fw-bold mb-3"><i class="bi bi-boxes text-primary me-2"></i>Sevk Edilen Ürün Kalemleri (@Model.Items.Count Kalem)</h5>
                <div class="table-responsive rounded-3 border">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4" style="width: 60px;">#</th>
                                <th>Barkod</th>
                                <th>Ürün Adı / Tanımı</th>
                                <th class="text-center" style="width: 150px;">Sevk Miktarı</th>
                                <th>Kalem Notu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int idx = 1; }
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4 text-muted fw-bold">@idx</td>
                                    <td class="font-monospace small">@(item.Barcode ?? "-")</td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.ProductName</div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fs-6">
                                            @item.Quantity Adet
                                        </span>
                                    </td>
                                    <td class="small text-muted">@(string.IsNullOrWhiteSpace(item.Notes) ? "-" : item.Notes)</td>
                                </tr>
                                idx++;
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="3" class="text-end pe-3">GENEL TOPLAM SEVK MİKTARI:</td>
                                <td class="text-center text-primary fs-6">@totalQty Adet</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
