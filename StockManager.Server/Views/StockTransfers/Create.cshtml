@{
    ViewData["Title"] = "Yeni Stok Transferi & Sevk İrsaliyesi";
    var warehouses = ViewBag.Warehouses as IEnumerable<StockManager.Server.Models.Warehouse> ?? new List<StockManager.Server.Models.Warehouse>();
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Transfer Listesine Dön
    </a>
</div>

<form asp-action="Create" method="post" id="transferForm">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <!-- Sol Kolon: Depo Seçimi ve Notlar -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-bottom p-4">
                    <h5 class="fw-bold mb-1"><i class="bi bi-buildings text-primary me-2"></i>Depo & Şube Seçimi</h5>
                    <p class="text-muted small mb-0">Ürünlerin çıkış yapacağı ve giriş yapacağı depoları belirleyin.</p>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-danger">
                            <i class="bi bi-box-arrow-right me-1"></i>ÇIKIŞ DEPOSU (Gönderen) <span class="text-danger">*</span>
                        </label>
                        <select name="sourceWarehouseId" id="sourceWarehouseId" class="form-select form-select-lg rounded-3 border-danger-subtle" required>
                            <option value="">-- Çıkış Deposu Seçiniz --</option>
                            @foreach (var wh in warehouses)
                            {
                                <option value="@wh.Id">@wh.Name [@wh.Code]</option>
                            }
                        </select>
                        <div class="form-text small">Ürünlerin düşüleceği kaynak depo.</div>
                    </div>

                    <div class="text-center my-2 text-muted">
                        <i class="bi bi-arrow-down-up fs-4"></i>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-success">
                            <i class="bi bi-box-arrow-in-right me-1"></i>GİRİŞ DEPOSU (Alıcı) <span class="text-danger">*</span>
                        </label>
                        <select name="targetWarehouseId" id="targetWarehouseId" class="form-select form-select-lg rounded-3 border-success-subtle" required>
                            <option value="">-- Giriş Deposu Seçiniz --</option>
                            @foreach (var wh in warehouses)
                            {
                                <option value="@wh.Id">@wh.Name [@wh.Code]</option>
                            }
                        </select>
                        <div class="form-text small">Ürünlerin ekleneceği hedef depo / şube.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Transfer Açıklaması / Sevk Notu</label>
                        <textarea name="notes" class="form-control rounded-3" rows="3" placeholder="Örn: Mağaza stok takviyesi, haftalık lojistik transfer vb."></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sağ Kolon: Transfer Edilecek Ürün Kalemleri -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100 d-flex flex-column">
                <div class="card-header bg-transparent border-bottom p-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <h5 class="fw-bold mb-1"><i class="bi bi-cart-plus text-primary me-2"></i>Transfer Edilecek Ürün Kalemleri</h5>
                        <p class="text-muted small mb-0">Çıkış deposunda stoğu bulunan ürünlerden kalem ekleyin.</p>
                    </div>
                </div>

                <div class="card-body p-4 d-flex flex-column flex-grow-1">
                    <!-- Ürün Seçim Barı -->
                    <div class="row g-2 align-items-end mb-4 bg-light p-3 rounded-3 border">
                        <div class="col-12 col-md-8">
                            <label class="form-label small fw-semibold text-muted">Çıkış Deposundaki Ürünler</label>
                            <select id="productSelector" class="form-select rounded-3" disabled>
                                <option value="">Önce Sol Taraftan Çıkış Deposu Seçiniz</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <button type="button" id="addItemBtn" class="btn btn-primary w-100 rounded-3 d-flex align-items-center justify-content-center gap-2" disabled>
                                <i class="bi bi-plus-lg"></i> Kalem Ekle
                            </button>
                        </div>
                    </div>

                    <!-- Kalem Tablosu -->
                    <div class="table-responsive flex-grow-1">
                        <table class="table table-hover align-middle" id="transferItemsTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Ürün Adı & Barkod</th>
                                    <th style="width: 140px;">Miktar</th>
                                    <th>Kalem Notu</th>
                                    <th style="width: 60px;" class="text-end">Sil</th>
                                </tr>
                            </thead>
                            <tbody id="itemsContainer">
                                <tr id="emptyRow">
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <i class="bi bi-box-seam display-6 d-block mb-2 opacity-50"></i>
                                        Henüz listeye ürün eklenmedi. Yukarıdan ürün seçip "Kalem Ekle" butonuna basın.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Alt Kaydet Barı -->
                    <div class="border-top pt-4 mt-auto d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div class="text-muted small">
                            <span id="totalItemsBadge" class="badge bg-secondary px-3 py-2 fs-6 me-2">0 Kalem</span>
                            <span id="totalQtyText" class="fw-bold">0 Toplam Adet</span>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4">İptal</a>
                            <button type="submit" id="submitTransferBtn" class="btn btn-primary rounded-pill px-5 shadow-sm d-flex align-items-center gap-2" disabled>
                                <i class="bi bi-check-lg"></i>
                                <span>Transferi Tamamla & Sevk İrsaliyesi Oluştur</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sourceSelect = document.getElementById('sourceWarehouseId');
            const targetSelect = document.getElementById('targetWarehouseId');
            const productSelector = document.getElementById('productSelector');
            const addItemBtn = document.getElementById('addItemBtn');
            const itemsContainer = document.getElementById('itemsContainer');
            const emptyRow = document.getElementById('emptyRow');
            const submitTransferBtn = document.getElementById('submitTransferBtn');
            const totalItemsBadge = document.getElementById('totalItemsBadge');
            const totalQtyText = document.getElementById('totalQtyText');

            let availableProducts = {};
            let addedProductIds = new Set();

            sourceSelect.addEventListener('change', async function () {
                const whId = this.value;
                if (targetSelect.value && targetSelect.value === whId) {
                    alert('Çıkış deposu ile Giriş deposu aynı olamaz!');
                    this.value = '';
                    return;
                }

                if (addedProductIds.size > 0) {
                    if (confirm('Çıkış deposunu değiştirirseniz eklemiş olduğunuz ürün kalemleri listesi temizlenecek. Devam edilsin mi?')) {
                        clearAllItems();
                    } else {
                        return;
                    }
                }

                if (!whId) {
                    productSelector.innerHTML = '<option value="">Önce Çıkış Deposu Seçiniz</option>';
                    productSelector.disabled = true;
                    addItemBtn.disabled = true;
                    return;
                }

                productSelector.innerHTML = '<option value="">Ürün listesi yükleniyor...</option>';
                productSelector.disabled = true;
                addItemBtn.disabled = true;

                try {
                    const response = await fetch(`/StockTransfers/GetWarehouseProducts?warehouseId=${whId}`);
                    const products = await response.json();
                    availableProducts = {};

                    if (products.length === 0) {
                        productSelector.innerHTML = '<option value="">Bu depoda stokta ürün bulunmuyor</option>';
                    } else {
                        productSelector.innerHTML = '<option value="">-- Transfer Etmek İçin Ürün Seçiniz --</option>';
                        products.forEach(p => {
                            availableProducts[p.id] = p;
                            const opt = document.createElement('option');
                            opt.value = p.id;
                            opt.textContent = `${p.name} [Barkod: ${p.barcode || '-'}] - Mevcut Stok: ${p.quantity} Adet`;
                            productSelector.appendChild(opt);
                        });
                        productSelector.disabled = false;
                        addItemBtn.disabled = false;
                    }
                } catch (err) {
                    console.error('Ürünler yüklenemedi:', err);
                    productSelector.innerHTML = '<option value="">Ürünler yüklenirken hata oluştu</option>';
                }
            });

            targetSelect.addEventListener('change', function () {
                if (sourceSelect.value && sourceSelect.value === this.value) {
                    alert('Giriş deposu ile Çıkış deposu aynı olamaz!');
                    this.value = '';
                }
            });

            addItemBtn.addEventListener('click', function () {
                const pid = productSelector.value;
                if (!pid) return;

                if (addedProductIds.has(pid)) {
                    alert('Bu ürün zaten listeye eklendi. listedeki miktarını artırabilirsiniz.');
                    return;
                }

                const product = availableProducts[pid];
                if (!product) return;

                if (emptyRow) emptyRow.style.display = 'none';

                const tr = document.createElement('tr');
                tr.dataset.productId = pid;
                tr.innerHTML = `
                    <td>
                        <input type="hidden" name="productIds" value="${pid}" />
                        <div class="fw-bold">${product.name}</div>
                        <div class="small text-muted font-monospace">Barkod: ${product.barcode || '-'} <span class="badge bg-light text-dark border ms-1">Maks: ${product.quantity} Adet</span></div>
                    </td>
                    <td>
                        <input type="number" name="quantities" class="form-control item-qty text-center fw-bold" value="1" min="1" max="${product.quantity}" required />
                    </td>
                    <td>
                        <input type="text" name="itemNotes" class="form-control form-control-sm" placeholder="Kalem notu (opsiyonel)" />
                    </td>
                    <td class="text-end">
                        <button type="button" class="btn btn-light btn-sm rounded-circle remove-btn" title="Sil">
                            <i class="bi bi-trash text-danger"></i>
                        </button>
                    </td>
                `;

                tr.querySelector('.remove-btn').addEventListener('click', function () {
                    tr.remove();
                    addedProductIds.delete(pid);
                    updateTotals();
                    if (addedProductIds.size === 0 && emptyRow) {
                        emptyRow.style.display = '';
                    }
                });

                tr.querySelector('.item-qty').addEventListener('input', function () {
                    const val = parseInt(this.value) || 0;
                    if (val > product.quantity) {
                        alert(`Bu depoda en fazla ${product.quantity} adet stok bulunmaktadır!`);
                        this.value = product.quantity;
                    }
                    if (val < 1) this.value = 1;
                    updateTotals();
                });

                itemsContainer.appendChild(tr);
                addedProductIds.add(pid);
                productSelector.value = '';
                updateTotals();
            });

            function updateTotals() {
                const rows = itemsContainer.querySelectorAll('tr[data-product-id]');
                let count = rows.length;
                let totalQty = 0;

                rows.forEach(r => {
                    const qtyInput = r.querySelector('.item-qty');
                    totalQty += parseInt(qtyInput.value) || 0;
                });

                totalItemsBadge.textContent = `${count} Kalem`;
                totalQtyText.textContent = `${totalQty} Toplam Adet`;
                submitTransferBtn.disabled = (count === 0);
            }

            function clearAllItems() {
                itemsContainer.innerHTML = `
                    <tr id="emptyRow">
                        <td colspan="4" class="text-center py-5 text-muted">
                            <i class="bi bi-box-seam display-6 d-block mb-2 opacity-50"></i>
                            Henüz listeye ürün eklenmedi. Yukarıdan ürün seçip "Kalem Ekle" butonuna basın.
                        </td>
                    </tr>
                `;
                addedProductIds.clear();
                updateTotals();
            }
        });
    </script>
}
