@model IEnumerable<StockManager.Server.Models.StockTransfer>

@{
    ViewData["Title"] = "Depolar Arası Stok Transferleri";
}

<div class="mb-3">
    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Geri
    </a>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-arrow-left-right text-primary me-2"></i>Depolar Arası Transfer Geçmişi</h2>
        <p class="text-muted mb-0">Depo ve mağaza şubeleriniz arasında yapılan tüm stok sevkiyatlarını ve resmi sevk irsaliyelerini inceleyin.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm rounded-pill px-4 py-2">
            <i class="bi bi-plus-lg"></i>
            <span>Yeni Transfer / Sevk İrsaliyesi Oluştur</span>
        </a>
    </div>
</div>

@if (TempData["success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-arrow-left-right display-1 text-muted opacity-50 mb-3 d-block"></i>
                <h4 class="fw-bold">Henüz Transfer İşlemi Yapılmadı</h4>
                <p class="text-muted mb-4">Depolar arası ilk stok sevkiyatınızı başlatarak ürün transfer belgelerini oluşturun.</p>
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2">
                    <i class="bi bi-plus-lg me-2"></i>İlk Transferi Başlat
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Transfer No</th>
                            <th>Tarih</th>
                            <th>Çıkış Deposu (Gönderen)</th>
                            <th></th>
                            <th>Giriş Deposu (Alıcı)</th>
                            <th>Kalem / Toplam Adet</th>
                            <th>Açıklama</th>
                            <th>Durum</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model)
                        {
                            var totalQty = t.Items.Sum(i => i.Quantity);
                            <tr>
                                <td class="ps-4 font-monospace fw-bold text-primary">
                                    <a asp-action="Details" asp-route-id="@t.Id" class="text-decoration-none">@t.TransferNumber</a>
                                </td>
                                <td>
                                    <div class="fw-medium">@t.TransferDate.ToLocalTime().ToString("dd.MM.yyyy")</div>
                                    <div class="small text-muted">@t.TransferDate.ToLocalTime().ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <span class="badge bg-danger-subtle text-danger px-3 py-2 fs-6">
                                        <i class="bi bi-box-arrow-right me-1"></i> @t.SourceWarehouseName
                                    </span>
                                </td>
                                <td class="text-center text-muted">
                                    <i class="bi bi-arrow-right fs-5"></i>
                                </td>
                                <td>
                                    <span class="badge bg-success-subtle text-success px-3 py-2 fs-6">
                                        <i class="bi bi-box-arrow-in-right me-1"></i> @t.TargetWarehouseName
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold">@t.Items.Count Kalem</div>
                                    <div class="small text-muted">Toplam @totalQty Adet Ürün</div>
                                </td>
                                <td class="small text-muted text-truncate" style="max-width: 180px;" title="@t.Notes">
                                    @(string.IsNullOrWhiteSpace(t.Notes) ? "-" : t.Notes)
                                </td>
                                <td>
                                    <span class="badge bg-success rounded-pill px-3 py-1"><i class="bi bi-check-circle me-1"></i>@t.Status</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1" title="Detaylar">
                                            <i class="bi bi-eye me-1"></i> İncele
                                        </a>
                                        <a asp-action="DownloadPdf" asp-route-id="@t.Id" class="btn btn-danger btn-sm rounded-pill px-3 shadow-sm" title="Sevk İrsaliyesi PDF">
                                            <i class="bi bi-file-earmark-pdf-fill me-1"></i> PDF
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
