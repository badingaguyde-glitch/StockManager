@model List<StockManager.Server.Models.Product>

@{
    ViewData["Title"] = "Düşük Stok & Satın Alma Siparişi (PO) Oluştur";
    var suppliers = ViewBag.Suppliers as List<StockManager.Server.Models.Supplier> ?? new List<StockManager.Server.Models.Supplier>();
    var warehouses = ViewBag.Warehouses as List<StockManager.Server.Models.Warehouse> ?? new List<StockManager.Server.Models.Warehouse>();
}

<style>
    .po-card {
        border: none;
        border-radius: 16px;
        background: var(--bs-card-bg, #ffffff);
        box-shadow: 0 4px 15px rgba(0,0,0,.05);
    }
    .auto-po-banner {
        background: linear-gradient(135deg, #1e3a8a, #3b82f6);
        color: #ffffff;
        border-radius: 16px;
        box-shadow: 0 8px 25px rgba(59, 130, 246, 0.25);
    }
    .table-responsive {
        border-radius: 12px;
    }
</style>

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> PO Listesine Dön
    </a>
</div>

<div class="auto-po-banner p-4 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-magic me-2"></i>Tek Tıkla Otomatik Satın Alma (PO) Motoru</h3>
        <p class="mb-0 opacity-75">Tedarikçisi tanımlı olan tüm düşük stoklu ürünler için tedarikçiye özel otomatik sipariş formları (PO) üretilir ve PDF olarak e-posta gönderilir.</p>
    </div>
    <div>
        <form asp-action="CreateAutoForAll" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-light btn-lg text-primary fw-bold px-4 rounded-3 shadow-sm d-flex align-items-center"
                    onclick="return confirm('Tüm düşük stoklu ürünler için tedarikçilere otomatik PO oluşturulup PDF e-posta ile iletilecek. Onaylıyor musunuz?')">
                <i class="bi bi-lightning-charge-fill text-warning me-2"></i> Tümüne Otomatik PO Oluştur & Gönder
            </button>
        </form>
    </div>
</div>

<div class="po-card p-4 mb-4">
    <h4 class="fw-bold mb-3"><i class="bi bi-funnel text-primary me-2"></i>Seçili Ürünlerden Manuel / Çoklu PO Oluştur</h4>
    <p class="text-muted small">Aşağıdaki listeden sipariş etmek istediğiniz ürünleri işaretleyin, sipariş edilecek tedarikçiyi ve teslim deposunu seçerek özel PO belgesi üretin.</p>

    <form asp-action="CreateBulk" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3 mb-4 bg-light p-3 rounded-3">
            <div class="col-md-4">
                <label class="form-label fw-semibold text-dark">Tedarikçi Seçimi <span class="text-danger">*</span></label>
                <select name="supplierId" class="form-select border-0 bg-white" required>
                    <option value="">-- Tedarikçi Seçiniz --</option>
                    @foreach (var s in suppliers)
                    {
                        <option value="@s.Id">@s.CompanyName (@(s.Email ?? "E-Posta Yok"))</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold text-dark">Hedef Teslim Deposu / Şubesi</label>
                <select name="targetWarehouseId" class="form-select border-0 bg-white">
                    @foreach (var w in warehouses)
                    {
                        <option value="@w.Id">@w.Name (@w.Code)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold text-dark">Sipariş Notu / Özel Talimatlar</label>
                <input type="text" name="notes" class="form-control border-0 bg-white" placeholder="Örn: İvedilikle sevk edilsin." />
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                <h5 class="mt-3 fw-bold">Tüm Stoklar Yeterli Seviyede!</h5>
                <p class="text-muted">Şu an kritik stok eşiğinin altında herhangi bir ürün bulunmamaktadır.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-4">
                    <thead class="bg-light text-muted">
                        <tr>
                            <th class="ps-3" style="width: 40px;">
                                <input class="form-check-input" type="checkbox" id="checkAll" onclick="toggleCheckboxes(this)" />
                            </th>
                            <th>Ürün Bilgisi</th>
                            <th>Mevcut Stok</th>
                            <th>Kritik Eşik</th>
                            <th>Tanımlı Tedarikçi</th>
                            <th style="width: 140px;">Sipariş Adedi</th>
                            <th style="width: 150px;">Birim Fiyat (₺)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var p = Model[i];
                            var defaultQty = Math.Max(10, (p.LowStockThreshold * 2) - p.Quantity);
                            var defaultPrice = p.PurchasePrice > 0 ? p.PurchasePrice : p.SalePrice * 0.7m;

                            <tr>
                                <td class="ps-3">
                                    <input class="form-check-input product-chk" type="checkbox" name="productIds" value="@p.Id" checked />
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@p.Name</div>
                                    <small class="text-muted"><i class="bi bi-upc me-1"></i>@p.Barcode</small>
                                </td>
                                <td>
                                    <span class="badge bg-danger bg-opacity-10 text-danger fs-6">@p.Quantity Adet</span>
                                </td>
                                <td>
                                    <span class="text-muted fw-semibold">@p.LowStockThreshold Adet</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(p.SupplierId))
                                    {
                                        var sup = suppliers.FirstOrDefault(s => s.Id == p.SupplierId);
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary">@(sup?.CompanyName ?? "Tanımlı Tedarikçi")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Tanımlı Değil</span>
                                    }
                                </td>
                                <td>
                                    <input type="number" name="orderedQuantities" class="form-control form-control-sm text-end fw-bold text-primary" value="@defaultQty" min="1" />
                                </td>
                                <td>
                                    <input type="number" step="0.01" name="unitPrices" class="form-control form-control-sm text-end" value="@defaultPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" min="0" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary px-5 py-2 rounded-3 shadow-sm fw-bold">
                    <i class="bi bi-file-earmark-pdf me-2"></i> Seçili Ürünler İçin PO Belgesi Oluştur & Gönder
                </button>
            </div>
        }
    </form>
</div>

@section Scripts {
    <script>
        function toggleCheckboxes(source) {
            checkboxes = document.getElementsByClassName('product-chk');
            for(var i=0, n=checkboxes.length;i<n;i++) {
                checkboxes[i].checked = source.checked;
            }
        }
    </script>
}
