@model IEnumerable<StockManager.Server.Models.Supplier>

@{
    ViewData["Title"] = "Tedarikçiler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Tedarikçiler</h2>
    <a asp-action="Create" class="btn btn-primary">Yeni Tedarikçi</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Firma Adı</th>
            <th>Yetkili Kişi</th>
            <th>Telefon</th>
            <th>E-posta</th>
            <th>Bakiye</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CompanyName</td>
                <td>@item.ContactName</td>
                <td>@item.Phone</td>
                <td>@item.Email</td>
                <td>@item.Balance</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Silmek istediğinize emin misiniz?');">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
