@model StockManager.Server.Models.Supplier

@{
    ViewData["Title"] = "Tedarikçi Ekle";
}

<div class="mb-3">
    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Geri
    </a>
</div>

<h2 class="mb-4 fw-bold"><i class="bi bi-truck text-primary me-2"></i>Tedarikçi Ekle</h2>

<div class="card glass-card p-4 border-0 shadow-sm" style="max-width: 600px; border-radius: 16px;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        
        <div class="mb-3">
            <label asp-for="CompanyName" class="form-label fw-semibold">Firma Adı</label>
            <input asp-for="CompanyName" class="form-control" placeholder="Firma / Şirket unvanı" required />
            <span asp-validation-for="CompanyName" class="text-danger small mt-1 d-block"></span>
        </div>
        
        <div class="mb-3">
            <label asp-for="ContactName" class="form-label fw-semibold">Yetkili Kişi</label>
            <input asp-for="ContactName" class="form-control" placeholder="Görüşülecek yetkili adı" />
            <span asp-validation-for="ContactName" class="text-danger small mt-1 d-block"></span>
        </div>
        
        <div class="mb-3">
            <label asp-for="Phone" class="form-label fw-semibold d-block">Telefon Numarası</label>
            <input asp-for="Phone" class="form-control intl-phone-input w-100" type="tel" />
            <span asp-validation-for="Phone" class="text-danger small mt-1 d-block"></span>
            <div class="phone-validation-error text-danger small mt-1" style="display:none;"></div>
        </div>
        
        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-semibold">E-Posta Adresi</label>
            <input asp-for="Email" class="form-control" type="email" placeholder="ornek@firma.com" />
            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
        </div>
        
        <div class="mb-3">
            <label asp-for="Balance" class="form-label fw-semibold">Başlangıç Borç/Alacak Bakiyesi</label>
            <input asp-for="Balance" class="form-control" type="number" step="0.01" min="0" max="1000000000" placeholder="0.00" />
            <span asp-validation-for="Balance" class="text-danger small mt-1 d-block"></span>
        </div>
        
        <div class="mt-4 pt-2">
            <button type="submit" class="btn btn-primary px-4 me-2">Kaydet</button>
            <a asp-action="Index" class="btn btn-secondary px-4">İptal</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
