@model StockManager.Server.Models.Warehouse

@{
    ViewData["Title"] = "Yeni Depo / Şube Ekle";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Depo Listesine Dön
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent border-bottom p-4">
                <h4 class="fw-bold mb-1"><i class="bi bi-building-add text-primary me-2"></i>Yeni Depo / Şube Ekle</h4>
                <p class="text-muted small mb-0">Stoklarınızı barındırmak ve yönetmek için yeni bir depo veya mağaza şubesi tanımlayın.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label fw-semibold">Depo / Şube Adı <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control form-control-lg rounded-3" placeholder="Örn: Kadıköy Şubesi, Ana Depo 2 vb." required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Code" class="form-label fw-semibold">Depo Kodu <span class="text-danger">*</span></label>
                            <input asp-for="Code" class="form-control form-control-lg rounded-3 text-uppercase font-monospace" placeholder="Örn: KDQ1" maxlength="10" required />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold">Telefon Numarası</label>
                            <input asp-for="Phone" class="form-control rounded-3" placeholder="Örn: 0216 123 45 67" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Durum & Özellikler</label>
                            <div class="d-flex gap-4 pt-2">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" checked />
                                    <label class="form-check-label fw-semibold" for="isActiveSwitch">Aktif Depo</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input asp-for="IsDefault" class="form-check-input" type="checkbox" id="isDefaultSwitch" />
                                    <label class="form-check-label fw-semibold text-primary" for="isDefaultSwitch">Varsayılan Depo</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold">Adres</label>
                            <textarea asp-for="Address" class="form-control rounded-3" rows="2" placeholder="Depo veya şube açık adresi"></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold">Açıklama / Notlar</label>
                            <textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="Depo hakkında ek bilgiler, lojistik detayları vb."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-4 mt-3 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4">İptal</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> Kaydet ve Oluştur
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
