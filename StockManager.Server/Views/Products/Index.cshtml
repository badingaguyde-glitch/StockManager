@model IEnumerable<StockManager.Server.Models.Product>

@{
    ViewData["Title"] = "Ürünler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Ürünler</h2>
        @if (ViewBag.ShowLowStockAlert == true)
        {
            <div class="alert alert-warning mb-0">
                @ViewBag.LowStockCount adet ürün kritik stok seviyesinin altında.
            </div>
        }
    </div>
    <div>
        <a asp-action="LowStock" class="btn btn-outline-warning me-2">Düşük Stok</a>
        <a asp-action="Create" class="btn btn-primary">Yeni Ürün</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="search" value="@(ViewBag.Search ?? "")" class="form-control" placeholder="Ara: isim, açıklama, barkod" />
    </div>
    <div class="col-auto">
        <select name="categoryId" class="form-select">
            <option value="">Tüm Kategoriler</option>
            @foreach (var c in (List<SelectListItem>)ViewBag.Categories)
            {
                if (c.Value == (ViewBag.CategoryId ?? ""))
                {
                    <option value="@c.Value" selected>@c.Text</option>
                }
                else
                {
                    <option value="@c.Value">@c.Text</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <select name="supplierId" class="form-select">
            <option value="">Tüm Tedarikçiler</option>
            @foreach (var s in (List<SelectListItem>)ViewBag.Suppliers)
            {
                if (s.Value == (ViewBag.SupplierId ?? ""))
                {
                    <option value="@s.Value" selected>@s.Text</option>
                }
                else
                {
                    <option value="@s.Value">@s.Text</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <input type="number" step="0.01" name="minPrice" value="@(ViewBag.MinPrice?.ToString() ?? "")" class="form-control" placeholder="Min Fiyat" />
    </div>
    <div class="col-auto">
        <input type="number" step="0.01" name="maxPrice" value="@(ViewBag.MaxPrice?.ToString() ?? "")" class="form-control" placeholder="Max Fiyat" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Filtrele</button>
        <a href="@Url.Action("Index", "Products")" class="btn btn-link">Temizle</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Barkod</th>
            <th>Ad</th>
            <th>Stok</th>
            <th>Alış</th>
            <th>Satış</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var isLowStock = item.Quantity <= item.LowStockThreshold;
            <tr class="@(isLowStock ? "table-warning" : "")">
                <td>@item.Barcode</td>
                <td>@item.Name</td>
                <td>@item.Quantity</td>
                <td>@item.PurchasePrice.ToString("0.00")</td>
                <td>@item.SalePrice.ToString("0.00")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Silmek istediğinize emin misiniz?');">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
