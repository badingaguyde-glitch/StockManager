@model IEnumerable<StockManager.Server.Models.Product>
@inject StockManager.Server.Services.IImageUploadService ImageService

@{
    ViewData["Title"] = "Ürünler";
}

<div class="mb-3">
    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Geri
    </a>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Ürünler</h2>
        @if (ViewBag.ShowLowStockAlert == true)
        {
            <div class="alert alert-warning mb-0">
                @ViewBag.LowStockCount adet ürün kritik stok seviyesinin altında.
            </div>
        }
    </div>
    <div>
        <a asp-action="LowStock" class="btn btn-outline-warning me-2">Düşük Stok</a>
        <a asp-action="Create" class="btn btn-primary">Yeni Ürün</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    @{
        var categories = ViewBag.Categories as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
        var suppliers = ViewBag.Suppliers as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    }
    <div class="col-auto">
        <input type="text" name="search" value="@(ViewBag.Search ?? "")" class="form-control"
               placeholder="Ara: isim, açıklama, barkod" />
    </div>
    <div class="col-auto">
        <select name="categoryId" class="form-select">
            <option value="">Tüm Kategoriler</option>
            @foreach (var c in categories)
            {
                if (c.Value == (ViewBag.CategoryId ?? ""))
                {
                    <option value="@c.Value" selected>@c.Text</option>
                }
                else
                {
                    <option value="@c.Value">@c.Text</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <select name="supplierId" class="form-select">
            <option value="">Tüm Tedarikçiler</option>
            @foreach (var s in suppliers)
            {
                if (s.Value == (ViewBag.SupplierId ?? ""))
                {
                    <option value="@s.Value" selected>@s.Text</option>
                }
                else
                {
                    <option value="@s.Value">@s.Text</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <input type="number" step="0.01" name="minPrice" value="@(ViewBag.MinPrice?.ToString() ?? "")"
               class="form-control" placeholder="Min Fiyat" />
    </div>
    <div class="col-auto">
        <input type="number" step="0.01" name="maxPrice" value="@(ViewBag.MaxPrice?.ToString() ?? "")"
               class="form-control" placeholder="Max Fiyat" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Filtrele</button>
        <a href="@Url.Action("Index", "Products")" class="btn btn-link">Temizle</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th style="width: 100px;">Görsel</th>
            <th>Barkod</th>
            <th>Ad</th>
            <th>Stok</th>
            <th>Alış</th>
            <th>Satış</th>
            <th class="text-center" style="width: 170px;">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var isLowStock = item.Quantity <= item.LowStockThreshold;
            <tr class="@(isLowStock ? "table-warning" : "")">
                <!-- 🆕 Görsel Sütunu -->
                <td class="text-center align-middle">
                    <div class="product-img-trigger d-inline-block" style="cursor: pointer;" data-name="@item.Name"
                         data-description="@(item.Description ?? "Açıklama belirtilmemiş")" data-quantity="@item.Quantity"
                         data-price="@item.SalePrice.ToString("0.00") ₺"
                         data-image="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "" : ImageService.GetOptimizedImageUrl(item.ImageUrl, 400, 400, 85))"
                         data-bs-toggle="modal" data-bs-target="#productDetailModal" title="Detayları görüntüle">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@ImageService.GetThumbnailUrl(item.ImageUrl, 80)" alt="@item.Name"
                                 class="img-thumbnail rounded bg-light"
                                 style="width: 80px; height: 80px; object-fit: contain; transition: transform 0.2s;">
                        }
                        else
                        {
                            <div class="bg-light border rounded d-flex align-items-center justify-content-center"
                                 style="width: 80px; height: 80px; font-size: 2rem; transition: transform 0.2s;">
                                 <i class="bi bi-image text-muted"></i>
                            </div>
                        }
                    </div>
                </td>
                <td class="align-middle">@item.Barcode</td>
                <td class="align-middle">@item.Name</td>
                <td class="align-middle">@item.Quantity</td>
                <td class="align-middle">@item.PurchasePrice.ToString("0.00") ₺</td>
                <td class="align-middle">@item.SalePrice.ToString("0.00") ₺</td>
                <td class="text-center align-middle">
                    <div class="d-flex justify-content-center align-items-center gap-2">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-pill px-3">
                            <i class="bi bi-pencil-square me-1"></i> Düzenle
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                    onclick="return confirm('Silmek istediğinize emin misiniz?');">
                                <i class="bi bi-trash3 me-1"></i> Sil
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal & Styles -->
<style>
    .product-img-trigger:hover img,
    .product-img-trigger:hover div {
        transform: scale(1.08);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    }
</style>

<!-- Product Detail Modal -->
<div class="modal fade" id="productDetailModal" tabindex="-1" aria-labelledby="productDetailModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header border-0 pb-0 bg-dark text-white p-3">
                <h5 class="modal-title fw-bold" id="productDetailModalLabel">
                    <i class="bi bi-info-circle-fill me-2 text-primary"></i>Ürün Detayı
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <div class="img-container bg-light rounded d-flex align-items-center justify-content-center p-3 border"
                         style="height: 250px; overflow: hidden; position: relative;">
                        <img id="modalProductImage" src="" alt="Ürün Görseli" class="img-fluid rounded"
                             style="max-height: 100%; object-fit: contain; display: none;">
                        <div id="modalProductPlaceholder" class="text-center" style="display: none;">
                            <i class="bi bi-image text-muted" style="font-size: 5rem;"></i>
                            <p class="text-muted mt-2 mb-0">Görsel Bulunmuyor</p>
                        </div>
                    </div>
                </div>

                <h3 id="modalProductName" class="fw-bold text-dark text-center mb-3"></h3>
                <p id="modalProductDescription" class="text-muted text-center mb-4 px-2"
                   style="font-size: 0.95rem; line-height: 1.5;"></p>

                <div class="row g-3">
                    <div class="col-6">
                        <div class="p-3 bg-light rounded text-center border-start border-primary border-4 shadow-sm">
                            <span class="text-muted d-block small mb-1"><i class="bi bi-boxes"></i> Stok Durumu</span>
                            <strong id="modalProductQuantity" class="fs-5 text-dark"></strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded text-center border-start border-success border-4 shadow-sm">
                            <span class="text-muted d-block small mb-1"><i class="bi bi-tag-fill"></i> Satış
                                Fiyatı</span>
                                <strong id="modalProductPrice" class="fs-5 text-success"></strong>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary w-100 py-2 fw-semibold" data-bs-dismiss="modal"
                            style="border-radius: 8px;">Kapat</button>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const modal = document.getElementById('productDetailModal');
                if (modal) {
                    modal.addEventListener('show.bs.modal', function (event) {
                        const button = event.relatedTarget;

                        const name = button.getAttribute('data-name');
                        const description = button.getAttribute('data-description');
                        const quantity = button.getAttribute('data-quantity');
                        const price = button.getAttribute('data-price');
                        const imageSrc = button.getAttribute('data-image');

                        const modalImage = document.getElementById('modalProductImage');
                        const modalPlaceholder = document.getElementById('modalProductPlaceholder');
                        const modalName = document.getElementById('modalProductName');
                        const modalDescription = document.getElementById('modalProductDescription');
                        const modalQuantity = document.getElementById('modalProductQuantity');
                        const modalPrice = document.getElementById('modalProductPrice');

                        if (imageSrc && imageSrc.trim() !== '') {
                            modalImage.src = imageSrc;
                            modalImage.style.display = 'block';
                            modalPlaceholder.style.display = 'none';
                        } else {
                            modalImage.src = '';
                            modalImage.style.display = 'none';
                            modalPlaceholder.style.display = 'block';
                        }

                        modalName.textContent = name;
                        modalDescription.textContent = description || 'Açıklama belirtilmemiş';
                        modalQuantity.textContent = quantity + ' Adet';
                        modalPrice.textContent = price;
                    });
                }
            });
        </script>
    }
