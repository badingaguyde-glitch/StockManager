@model IEnumerable<StockManager.Server.Models.Product>
@inject StockManager.Server.Services.IImageUploadService ImageService

@{
    ViewData["Title"] = "Ürünler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Ürünler</h2>
        @if (ViewBag.ShowLowStockAlert == true)
        {
            <div class="alert alert-warning mb-0">
                @ViewBag.LowStockCount adet ürün kritik stok seviyesinin altında.
            </div>
        }
    </div>
    <div>
        <a asp-action="LowStock" class="btn btn-outline-warning me-2">Düşük Stok</a>
        <a asp-action="Create" class="btn btn-primary">Yeni Ürün</a>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th style="width: 100px;">Görsel</th>
            <th>Barkod</th>
            <th>Ad</th>
            <th>Stok</th>
            <th>Alış</th>
            <th>Satış</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var isLowStock = item.Quantity <= item.LowStockThreshold;
            <tr class="@(isLowStock ? "table-warning" : "")">
                <!-- 🆕 Görsel Sütunu -->
                <td class="text-center">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@ImageService.GetThumbnailUrl(item.ImageUrl, 80)" alt="@item.Name" class="img-thumbnail rounded" style="width: 80px; height: 80px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2rem;">
                            <i class="bi bi-image text-muted"></i>
                        </div>
                    }
                </td>
                <td>@item.Barcode</td>
                <td>@item.Name</td>
                <td>@item.Quantity</td>
                <td>@item.PurchasePrice.ToString("0.00")</td>
                <td>@item.SalePrice.ToString("0.00")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Silmek istediğinize emin misiniz?');">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
