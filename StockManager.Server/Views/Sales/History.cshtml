@model IEnumerable<StockManager.Server.Models.Sale>

@{
    ViewData["Title"] = "Satış Geçmişi";
}

<div class="mb-3">
    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Geri
    </a>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Satış Geçmişi</h2>
    <a asp-action="POS" class="btn btn-primary">Yeni Satış</a>
</div>

@if (!Model.Any()){
    <div class="alert alert-info">Henüz satılan ürün yok.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Fatura No</th>
                <th>Tarih</th>
                <th>Müşteri</th>
                <th>Satılan Ürünler</th>
                <th>Toplam Tutar</th>
                <th>Ödeme</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var customerNames = ViewBag.CustomerNames as Dictionary<string, string> ?? new Dictionary<string, string>();
                var customerName = item.CustomerId != null && customerNames.ContainsKey(item.CustomerId) 
                    ? customerNames[item.CustomerId] 
                    : "Müşteri Belirtilmedi";

                <tr>
                    <td class="fw-bold text-dark">@item.InvoiceNumber</td>
                    <td>@item.SaleDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        @if (item.CustomerId != null && customerNames.ContainsKey(item.CustomerId))
                        {
                            <span class="badge bg-light text-dark border border-secondary-subtle px-2 py-1.5"><i class="bi bi-person-fill me-1"></i>@customerName</span>
                        }
                        else
                        {
                            <span class="text-muted small">@customerName</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var subItem in item.Items)
                            {
                                <span class="badge bg-secondary-subtle text-dark border px-2 py-1">
                                    @subItem.ProductName <strong class="text-primary">x@(subItem.Quantity)</strong>
                                </span>
                            }
                        </div>
                    </td>
                    <td class="fw-bold text-dark">@item.TotalAmount.ToString("0.00") ₺</td>
                    <td>
                        @switch (item.PaymentType)
                        {
                            case StockManager.Server.Models.PaymentType.Cash:
                                <span class="badge bg-success"><i class="bi bi-cash me-1"></i>Nakit</span>
                                break;
                            case StockManager.Server.Models.PaymentType.Card:
                                <span class="badge bg-primary"><i class="bi bi-credit-card me-1"></i>Kart</span>
                                break;
                            case StockManager.Server.Models.PaymentType.Debt:
                                <span class="badge bg-warning text-dark"><i class="bi bi-book-half me-1"></i>Veresiye</span>
                                break;
                        }
                    </td>
                    <td>
                        <div class="btn-group">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i> Detay
                            </a>
                            <a asp-action="Invoice" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-file-earmark-text"></i> Fatura
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}