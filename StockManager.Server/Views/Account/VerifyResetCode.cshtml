@model StockManager.Server.Models.VerifyResetCodeViewModel
@{
    ViewData["Title"] = "Doğrulama Kodu";
    Layout = null;
    var validityMinutes = ViewBag.CodeValidityMinutes ?? 5;
    var maxAttempts = ViewBag.MaxAttempts ?? 5;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StockManager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background-color: #f8f9fa; min-height: 100vh; }
        .card { border: none; border-radius: 12px; }
        .code-input { letter-spacing: 6px; font-size: 1.25rem; text-align: center; }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center py-5">
    <div class="container" style="max-width: 420px;">
        <div class="text-center mb-4">
            <h2 class="fw-bold text-primary"><i class="bi bi-shield-lock"></i> Doğrulama Kodu</h2>
            <p class="text-muted">E-postanıza gönderilen 6 haneli kodu giriniz.</p>
        </div>

        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info">@TempData["InfoMessage"]</div>
        }

        <div class="card shadow-lg">
            <div class="card-body p-4">
                <form asp-action="VerifyResetCode" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small">E-posta</label>
                        <input asp-for="Email" class="form-control" readonly />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Code" class="form-label fw-bold"></label>
                        <input asp-for="Code" class="form-control code-input" maxlength="6" placeholder="000000"
                               inputmode="numeric" pattern="[0-9]{6}" autofocus />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold mb-2">Kodu Doğrula</button>
                    <a asp-action="ForgotPassword" class="btn btn-outline-secondary w-100">Yeni Kod Talep Et</a>
                </form>
            </div>
        </div>

        <div class="alert alert-warning mt-3 small mb-0">
            <i class="bi bi-clock"></i> Kod <strong>@validityMinutes dakika</strong> geçerlidir.
            <strong>@maxAttempts kez</strong> yanlış girilirse kod iptal edilir.
        </div>
    </div>
</body>
</html>
