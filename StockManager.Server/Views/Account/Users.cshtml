@model IEnumerable<StockManager.Server.Models.User>
@using StockManager.Server.Models

@{
    ViewData["Title"] = "Personel Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Personel Yönetimi</h2>
    <a asp-action="Register" class="btn btn-primary">Yeni Personel Ekle</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Kullanıcı Adı</th>
            <th>E-posta</th>
            <th>Mevcut Rol</th>
            <th>Rolü Güncelle</th>
            <th>Aksiyonlar</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            var isSelf = user.Username == User.Identity?.Name;
            <tr>
                <td class="fw-bold">
                    @user.Username @(isSelf ? "(Siz)" : "")
                </td>
                <td>@user.Email</td>
                <td>
                    @switch (user.Role)
                    {
                        case UserRole.Admin:
                            <span class="badge bg-danger">Yönetici (Admin)</span>
                            break;
                        case UserRole.Personel:
                            <span class="badge bg-success">Personel</span>
                            break;
                        case UserRole.Muhasebeci:
                            <span class="badge bg-info text-dark">Muhasebeci</span>
                            break;
                    }
                </td>
                <td>
                    @if (!isSelf)
                    {
                        <form asp-action="ChangeRole" method="post" class="d-inline-flex gap-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@user.Id" />
                            <select name="role" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<UserRole>()" onchange="this.form.submit()">
                            </select>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted small">Kendi rolünüzü değiştiremezsiniz.</span>
                    }
                </td>
                <td>
                    @if (!isSelf)
                    {
                        <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('@user.Username adlı personeli silmek istediğinize emin misiniz?');">
                                Hesabı Sil
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>