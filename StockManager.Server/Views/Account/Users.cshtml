@model IEnumerable<StockManager.Server.Models.User>
@using StockManager.Server.Models

@{
    ViewData["Title"] = "Personel Yönetimi";
}

<div class="mb-3">
    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Geri
    </a>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Personel Yönetimi</h2>
    <a asp-action="Register" class="btn btn-primary">Yeni Personel Ekle</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Kullanıcı Adı</th>
            <th>E-posta</th>
            <th>Mevcut Rol</th>
            <th>Rolü Güncelle</th>
            <th>Aksiyonlar</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            var isSelf = user.Username == User.Identity?.Name;
            <tr>
                <td class="fw-bold">
                    @user.Username @(isSelf ? "(Siz)" : "")
                </td>
                <td>@user.Email</td>
                <td>
                    @switch (user.Role)
                    {
                        case UserRole.Admin:
                            <span class="badge bg-danger">Yönetici (Admin)</span>
                            break;
                        case UserRole.Personel:
                            <span class="badge bg-success">Personel</span>
                            break;
                        case UserRole.Muhasebeci:
                            <span class="badge bg-info text-dark">Muhasebeci</span>
                            break;
                    }
                </td>
                <td>
                    @if (!isSelf)
                    {
                        <form asp-action="ChangeRole" method="post" class="d-inline-flex gap-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@user.Id" />
                            @{
                                string? selAdmin = user.Role == UserRole.Admin ? "selected" : null;
                                string? selPersonel = user.Role == UserRole.Personel ? "selected" : null;
                                string? selMuhasebeci = user.Role == UserRole.Muhasebeci ? "selected" : null;
                            }
                            <select name="role" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="0" selected="@selAdmin">Yönetici (Admin)</option>
                                <option value="1" selected="@selPersonel">Personel</option>
                                <option value="2" selected="@selMuhasebeci">Muhasebeci</option>
                            </select>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted small">Kendi rolünüzü değiştiremezsiniz.</span>
                    }
                </td>
                <td>
                    @if (!isSelf)
                    {
                        <!-- Şifreyi Sıfırla (Restart) Formu -->
                        <form asp-action="ResetUserPassword" method="post" class="d-inline me-1" onsubmit="return handleResetSubmit(this, '@user.Username')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@user.Id" />
                            <button type="submit" class="btn btn-sm btn-warning text-dark fw-bold">
                                <i class="bi bi-arrow-counterclockwise"></i> Şifreyi Sıfırla
                            </button>
                        </form>

                        <!-- Hesabı Sil Formu -->
                        <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('@user.Username adlı personeli silmek istediğinize emin misiniz?');">
                                <i class="bi bi-trash"></i> Hesabı Sil
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Global Yükleniyor Paneli (Overlay) -->
<div id="loadingOverlay" class="position-fixed top-0 start-0 w-100 h-100 d-none justify-content-center align-items-center bg-dark bg-opacity-50" style="z-index: 9999;">
    <div class="card p-4 text-center border-0 shadow-lg" style="max-width: 350px; border-radius: 12px;">
        <div class="spinner-border text-warning mb-3" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">Yükleniyor...</span>
        </div>
        <h5 class="fw-bold mb-1"><i class="bi bi-envelope-paper-fill text-warning me-1"></i> Şifre Sıfırlanıyor</h5>
        <p class="text-muted small mb-0">Yeni şifre üretiliyor, veritabanı güncelleniyor ve personele e-posta gönderiliyor. Lütfen bekleyin...</p>
    </div>
</div>

@section Scripts {
    <script>
        function handleResetSubmit(form, username) {
            if (!confirm(username + ' adlı personelin şifresini sıfırlamak ve yeni şifreyi e-posta ile göndermek istediğinize emin misiniz?')) {
                return false;
            }

            // 1. Ekranı Kilitle (Overlay göster)
            const overlay = document.getElementById('loadingOverlay');
            if (overlay) {
                overlay.classList.remove('d-none');
                overlay.classList.add('d-flex');
            }

            // 2. Butonu kilitle ve durumunu güncelle
            const button = form.querySelector('button[type="submit"]');
            if (button) {
                button.disabled = true;
                button.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Sıfırlanıyor...';
            }

            // 3. Sayfadaki diğer tüm etkileşimleri kilitle
            document.querySelectorAll('button, select, a').forEach(el => {
                if (el !== button) {
                    if (el.tagName === 'A') {
                        el.classList.add('disabled');
                        el.style.pointerEvents = 'none';
                    } else {
                        el.disabled = true;
                    }
                }
            });

            return true; // Formun gönderilmesine izin ver
        }
    </script>
}