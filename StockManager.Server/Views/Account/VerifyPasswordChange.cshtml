@{
    ViewData["Title"] = "Şifre Güncelleme Doğrulaması";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-lg border-0 rounded-3 mt-5">
            <div class="card-header bg-dark text-white text-center py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-shield-lock-fill"></i> Güvenlik Doğrulaması</h4>
            </div>
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div class="display-6 text-primary mb-2">
                        <i class="bi bi-envelope-check"></i>
                    </div>
                    <h5 class="fw-bold">Doğrulama Kodu Gönderildi</h5>
                    <p class="text-muted small px-3">
                        Lütfen e-posta adresinize gönderilen 6 haneli doğrulama kodunu aşağıdaki alana giriniz.
                    </p>
                </div>

                <form asp-action="VerifyPasswordChange" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Doğrulama Kodu Girişi -->
                    <div class="mb-4">
                        <label for="code" class="form-label fw-bold">6 Haneli Doğrulama Kodu</label>
                        <input type="text" name="code" id="code" 
                               class="form-control form-control-lg text-center fw-bold fs-3" 
                               placeholder="******" maxlength="6" required autocomplete="off" />
                        <div class="form-text text-center text-muted">Kodun geçerlilik süresi 15 dakikadır.</div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-dark btn-lg fw-bold">Şifreyi Onayla ve Güncelle</button>
                        <a asp-action="Profile" class="btn btn-outline-secondary">Profilime Geri Dön</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>