@{
    ViewData["Title"] = "Erişim Engellendi";
}

<div class="mb-3">
    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Geri
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-6 text-center mt-5">
        <div class="display-1 text-danger"><i class="bi bi-shield-slash"></i></div>
        <h2 class="fw-bold text-danger mt-3">Erişim Engellendi</h2>
        <p class="text-muted mt-2">Bu sayfayı görüntülemek için gerekli yetkiye veya role sahip değilsiniz.</p>
        <hr class="my-4" />
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ana Sayfaya Dön</a>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">Farklı Hesapla Giriş Yap</button>
            </form>
        </div>
    </div>
</div>
