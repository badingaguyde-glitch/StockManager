@model IEnumerable<StockManager.Server.Models.Customer>

@{
    ViewData["Title"] = "Veresiye Tahsilat";
    var totalDebt = Model.Sum(c => Math.Abs(c.Balance));
}

<style>
    .collection-card {
        border: none;
        border-radius: 16px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .collection-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 28px -8px rgba(220,53,69,0.25) !important;
    }
    .debt-badge {
        font-size: 1.05rem;
        font-weight: 700;
        letter-spacing: 0.01em;
    }
    .collect-input {
        max-width: 160px;
    }
    .alert-info-custom {
        border-left: 4px solid #0dcaf0;
        background: rgba(13,202,240,0.08);
        border-radius: 10px;
    }
</style>

<div class="mb-3">
    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Geri
    </a>
</div>

@if (TempData["success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Başlık -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="mb-1 fw-bold">
            <i class="bi bi-cash-stack text-danger me-2"></i>Veresiye Tahsilat
        </h2>
        <p class="text-muted small mb-0">
            Açık borcu olan müşterilerin veresiyelerini tahsil edin.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm fw-semibold">
            <i class="bi bi-people me-1"></i> Tüm Müşteriler
        </a>
    </div>
</div>

<!-- Özet Kart -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card collection-card shadow-sm border-0 bg-danger-subtle">
            <div class="card-body py-3 px-4 d-flex align-items-center gap-3">
                <div class="rounded-3 bg-danger bg-opacity-15 p-3">
                    <i class="bi bi-exclamation-circle-fill text-danger fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Borçlu Müşteri</div>
                    <div class="fw-bold fs-4 text-danger">@Model.Count()</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card collection-card shadow-sm border-0 bg-warning-subtle">
            <div class="card-body py-3 px-4 d-flex align-items-center gap-3">
                <div class="rounded-3 bg-warning bg-opacity-15 p-3">
                    <i class="bi bi-wallet2 text-warning fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Toplam Alacak</div>
                    <div class="fw-bold fs-4 text-warning">@totalDebt.ToString("0.00") ₺</div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-check-circle-fill text-success" style="font-size: 3.5rem;"></i>
        <h5 class="mt-3 fw-bold text-success">Tüm veresiyeler tahsil edildi!</h5>
        <p class="text-muted">Şu an açık borcu olan müşteri bulunmamaktadır.</p>
        <a asp-action="Index" class="btn btn-outline-primary mt-2">Müşteri Listesine Dön</a>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header py-3 px-4 border-bottom d-flex align-items-center gap-2">
            <i class="bi bi-list-check text-danger"></i>
            <span class="fw-bold">Açık Veresiye Listesi</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Müşteri Adı</th>
                            <th>Şirket</th>
                            <th>Telefon</th>
                            <th class="text-end text-danger fw-bold">Açık Borç</th>
                            <th class="text-center" style="min-width:260px;">Tahsilat Yap</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            var debt = Math.Abs(c.Balance);
                            <tr>
                                <td class="ps-4 fw-semibold">
                                    <i class="bi bi-person-circle me-1 text-muted"></i>
                                    <a asp-action="Details" asp-route-id="@c.Id" class="text-decoration-none">@c.FullName</a>
                                </td>
                                <td class="text-muted small">@(c.CompanyName ?? "—")</td>
                                <td class="text-muted small">@(c.Phone ?? "—")</td>
                                <td class="text-end">
                                    <span class="badge bg-danger debt-badge px-3 py-2">@debt.ToString("0.00") ₺</span>
                                </td>
                                <td class="text-center">
                                    <form asp-action="Collect" method="post" class="d-flex justify-content-center align-items-center gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="customerId" value="@c.Id" />
                                        <input type="number"
                                               name="amount"
                                               class="form-control form-control-sm collect-input"
                                               placeholder="Tutar (₺)"
                                               min="0.01"
                                               max="@debt.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                               step="0.01"
                                               required />
                                        <button type="submit"
                                                class="btn btn-sm btn-success rounded-pill px-3 fw-semibold">
                                            <i class="bi bi-check-lg me-1"></i> Tahsil Et
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="alert alert-info-custom mt-4 px-4 py-3">
        <i class="bi bi-info-circle-fill text-info me-2"></i>
        <strong>Bilgi:</strong> Tahsilat tutarını girerek "Tahsil Et" butonuna basın.
        Maksimum tutar müşterinin mevcut borcuna eşit olabilir.
    </div>
}
